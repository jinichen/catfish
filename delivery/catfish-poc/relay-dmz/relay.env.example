# DMZ 手机中转站的配置 (docker-compose.relay.yml 读这个文件)
#
# 中央的数据库 —— 中转站只写两张元数据表 (配对关系 / 连接记录), 没有内容。
# 要从 DMZ 能连到内网 PostgreSQL 的 5432 (客户 IT 开一条 DMZ → 中央的单向规则)。
CATFISH_DB_URL=postgresql://catfish:<数据库密码>@<中央内网地址>:5432/catfish

# 登录服务 (OIDC) —— 跟中央网关的 CATFISH_OIDC_ISSUER 填同一个值。
# ⚠ 手机在外网登录, 所以这个地址必须是外网能打开的那个 https 域名 (见 INSTALL.md)。
CATFISH_OIDC_ISSUER=https://<对外域名>
CATFISH_OIDC_AUDIENCE=catfish-companion,catfish-gateway
# 中转站自己去哪取验签公钥 (走内网直连 identity 就行)
CATFISH_OIDC_JWKS_URI=http://<中央内网地址>:8998/.well-known/jwks.json

# 每人最多配几台手机, 跟中央那边填一样的
CATFISH_MOBILE_MAX_DEVICES=3
