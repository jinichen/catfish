# Catfish Central 服务器 config · IT 填写以下 secret 后 mv 成 .env
# 敏感字段 · 客户 IT 自己生成 · 不从 Catfish 团队分发.

# PG · Postgres 密码 (随机字符串 · 至少 24 字符)
PG_PASSWORD=

# JWT signing key · openssl rand -hex 32 生成
JWT_SIGNING_KEY=

# LLM provider keys (客户 IT 自己申请 · 用不到留空)
DASHSCOPE_API_KEY=
GEMINI_API_KEY=

# 内网私有 LLM (若客户有 · 一般不填 · 用公网 provider)
INTERNAL_LLM_BASE_QWEN_MAIN=
INTERNAL_LLM_BASE_QWEN_VISION=
INTERNAL_LLM_BASE_BGE_M3=
INTERNAL_LLM_KEY=

# OIDC · setup.sh 会按 SERVER_IP / HTTPS 自动写入, 不要删这些有效字段
CATFISH_OIDC_ISSUER=
CATFISH_IDENTITY_ISSUER=
CATFISH_IDENTITY_CORS_ORIGINS=
CATFISH_OIDC_AUDIENCE=catfish-companion,catfish-gateway
# CATFISH_ENV=prod

# Gateway → Identity admin API · 同一 Compose 默认值; 外置 Identity 时改成可达地址
CATFISH_IDENTITY_URL=http://identity:8998

# 运行模式 · setup.sh 按启动参数写入
CATFISH_ENABLE_HTTPS=1
CATFISH_HTTPS_PORT=443
GATEWAY_WORKERS=1
IDENTITY_WORKERS=2

# compose 项目名 · setup.sh 自动写, 不要手改。卷和网络都挂在它下面
# (<项目名>_pgdata 等), 钉死是为了跟目录名脱钩 —— 目录改名不能变成"换一套空库"。
COMPOSE_PROJECT_NAME=
