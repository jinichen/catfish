+            headers = dict(_CORS_HEADERS)
+            headers["Access-Control-Allow-Origin"] = origin
+            headers["Vary"] = "Origin"
+            headers["Access-Control-Max-Age"] = "600"
+            return headers
+
+        if not self._cors_origins:
             return None
 
