+    #     server bound to 127.0.0.1.
+    # BL-HERMES-API-CORS-FIX (5/19): Catfish Companion (Tauri 2) was getting
+    # "Load failed" on fetch to http://127.0.0.1:8642/v1/chat/completions
+    # because the preflight OPTIONS was 403'd by the strict allowlist.
+    _TAURI_ORIGINS = ("tauri://localhost", "http://tauri.localhost")
+
+    def _is_tauri_origin(self, origin: str) -> bool:
+        return origin in self._TAURI_ORIGINS
+
     def _cors_headers_for_origin(self, origin: str) -> Optional[Dict[str, str]]:
         """Return CORS headers for an allowed browser origin."""
-        if not origin or not self._cors_origins:
