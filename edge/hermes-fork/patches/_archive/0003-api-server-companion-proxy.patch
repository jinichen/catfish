@@ -0,0 +1,431 @@
+"""
+Tests for the Companion-proxy (BL-AUTH-DECOUPLE-A5).
+
+Covers:
+- Path-prefix allowlist (in /api/, /v1/, /a2a/, /healthz pass; other 404).
+- Auth required: requests without API_SERVER_KEY get 401, never touch
+  upstream.
+- Service-token swap: outgoing Authorization → ``Bearer ${HERMES_SERVICE_TOKEN}``.
+- X-Catfish-User resolution: JWT sub > explicit header > env fallback.
+- Hop-by-hop / cookie / host headers stripped from upstream request.
+- Streaming responses (text/event-stream) relayed chunk-by-chunk, not
+  buffered.
+- Hermes's own first-party routes (/v1/models, /health, /v1/chat/completions)
+  still resolve to their dedicated handlers and never hit the proxy.
+
+These are unit-ish tests — we mock the upstream catfish-gateway with an
+``aiohttp`` test server rather than hitting the real 8999.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from typing import Any, Dict, List, Tuple
+from unittest.mock import patch
+
+import pytest
+from aiohttp import web
+
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+
+class _CapturedRequest:
+    """Snapshot of the inbound request that the fake gateway received."""
+
+    __slots__ = ("method", "path", "query", "headers", "body")
+
+    def __init__(self, method: str, path: str, query: str, headers: Dict[str, str], body: bytes):
+        self.method = method
+        self.path = path
+        self.query = query
+        self.headers = headers
+        self.body = body
+
+
+async def _start_fake_gateway(handler) -> Tuple[web.AppRunner, str]:
+    """Spin up an aiohttp app exposing *handler* on a random local port."""
+    app = web.Application()
+    app.router.add_route("*", "/{tail:.*}", handler)
+    runner = web.AppRunner(app)
+    await runner.setup()
+    site = web.TCPSite(runner, "127.0.0.1", 0)
+    await site.start()
+    # AppRunner doesn't expose the bound port cleanly; reach into the socket.
+    server = site._server
+    sockets = getattr(server, "sockets", None) or []
+    port = sockets[0].getsockname()[1] if sockets else 0
+    return runner, f"http://127.0.0.1:{port}"
+
+
+def _make_adapter(api_key: str = "test-key") -> APIServerAdapter:
+    cfg = PlatformConfig(extra={"host": "127.0.0.1", "port": 0, "key": api_key})
+    return APIServerAdapter(cfg)
+
+
+async def _start_adapter(adapter: APIServerAdapter) -> Tuple[web.AppRunner, str]:
+    """Start the adapter's aiohttp app on a local port and return its URL."""
+    # connect() does port binding internally — but it picks 8642. For tests we
+    # build a parallel runner from the same routes config to avoid clobber.
+    adapter._app = web.Application(client_max_size=10_000_000)
+    adapter._app["api_server_adapter"] = adapter
+    # Mirror the route table the production connect() registers, ending in
+    # the catch-all proxy.
+    adapter._app.router.add_get("/health", adapter._handle_health)
+    adapter._app.router.add_get("/v1/models", adapter._handle_models)
+    for method in ("GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"):
+        adapter._app.router.add_route(method, "/{proxy_path:.*}", adapter._handle_companion_proxy)
+    runner = web.AppRunner(adapter._app)
+    await runner.setup()
+    site = web.TCPSite(runner, "127.0.0.1", 0)
+    await site.start()
+    sockets = getattr(site._server, "sockets", None) or []
+    port = sockets[0].getsockname()[1] if sockets else 0
+    return runner, f"http://127.0.0.1:{port}"
+
+
+# ---------------------------------------------------------------------------
+# Pure unit tests (no I/O) for the helper functions
+# ---------------------------------------------------------------------------
+
+
+class TestPathAllowlist:
+    def test_api_prefix_allowed(self):
+        assert APIServerAdapter._path_is_proxyable("/api/me") is True
+        assert APIServerAdapter._path_is_proxyable("/api/quota/me") is True
+        assert APIServerAdapter._path_is_proxyable("/api/learn/start_recording") is True
+
+    def test_v1_prefix_allowed(self):
+        assert APIServerAdapter._path_is_proxyable("/v1/catalog") is True
+        assert APIServerAdapter._path_is_proxyable("/v1/mcp/registry") is True
+        assert APIServerAdapter._path_is_proxyable("/v1/hub/skills") is True
+
+    def test_a2a_prefix_allowed(self):
+        assert APIServerAdapter._path_is_proxyable("/a2a/ask") is True
+
+    def test_healthz_allowed(self):
+        assert APIServerAdapter._path_is_proxyable("/healthz") is True
+
+    def test_unknown_prefix_rejected(self):
+        assert APIServerAdapter._path_is_proxyable("/etc/passwd") is False
+        assert APIServerAdapter._path_is_proxyable("/admin") is False
+        assert APIServerAdapter._path_is_proxyable("") is False
+        assert APIServerAdapter._path_is_proxyable("/") is False
+
+
+class TestProxyHeaderShaping:
+    def test_strip_hop_by_hop_and_auth(self):
+        adapter = _make_adapter()
+        with patch.dict("os.environ", {"HERMES_SERVICE_TOKEN": "svc-tok"}, clear=False):
+            class _Req:
+                headers = {
+                    "Host": "127.0.0.1:8642",
+                    "Authorization": "Bearer some-user-jwt",
+                    "X-Catfish-User": "hijacker@evil.com",
+                    "Cookie": "session=abc",
+                    "Content-Type": "application/json",
+                    "Accept": "application/json",
+                    "Origin": "tauri://localhost",
+                    "X-Custom-Trace": "trace-xyz",
+                }
+            out = adapter._build_proxy_request_headers(_Req(), "real@user.com")
+        assert out["Authorization"] == "Bearer svc-tok"
+        assert out["X-Catfish-User"] == "real@user.com"
+        assert out["Content-Type"] == "application/json"
+        assert out["X-Custom-Trace"] == "trace-xyz"
+        # Stripped:
+        for forbidden in ("Host", "Cookie", "Origin"):
+            assert forbidden not in out
+
+    def test_no_service_token_means_no_auth(self):
+        adapter = _make_adapter()
+        with patch.dict("os.environ", {}, clear=True):
+            class _Req:
+                headers = {"Accept": "application/json"}
+            out = adapter._build_proxy_request_headers(_Req(), "")
+        # Without a service token configured we MUST NOT forward a bogus
+        # Authorization header — upstream will then 401, which is the
+        # correct surface for the misconfig.
+        assert "Authorization" not in out
+        assert "X-Catfish-User" not in out
+
+
+class TestResponseHeaderFilter:
+    def test_strips_cors_and_hop_by_hop(self):
+        adapter = _make_adapter()
+        raw = {
+            "Content-Type": "application/json",
+            "Content-Length": "42",
+            "Transfer-Encoding": "chunked",
+            "Access-Control-Allow-Origin": "*",
+            "Access-Control-Allow-Credentials": "true",
+            "X-Trace-Id": "abc",
+        }
+        out = adapter._filter_proxy_response_headers(raw)
+        assert out["Content-Type"] == "application/json"
+        assert out["X-Trace-Id"] == "abc"
+        for stripped in ("Content-Length", "Transfer-Encoding",
+                         "Access-Control-Allow-Origin",
+                         "Access-Control-Allow-Credentials"):
+            assert stripped not in out
+
+
+class TestGatewayBaseURLDerivation:
+    def test_env_override_wins(self):
+        adapter = _make_adapter()
+        with patch.dict("os.environ", {"CATFISH_GATEWAY_BASE_URL": "http://example.test:9999"}, clear=False):
+            assert adapter._catfish_gateway_base_url() == "http://example.test:9999"
+
+    def test_strips_trailing_v1(self):
+        adapter = _make_adapter()
+        with patch("gateway.run._resolve_runtime_agent_kwargs",
+                   return_value={"base_url": "http://127.0.0.1:8999/v1"}):
+            with patch.dict("os.environ", {}, clear=False):
+                # Make sure env override is empty.
+                import os
+                os.environ.pop("CATFISH_GATEWAY_BASE_URL", None)
+                assert adapter._catfish_gateway_base_url() == "http://127.0.0.1:8999"
+
+
+# ---------------------------------------------------------------------------
+# Integration-ish tests with a fake upstream gateway
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_proxy_get_api_me_forwards_service_token_and_user():
+    """GET /api/me must reach upstream with service token + X-Catfish-User."""
+    captured: List[_CapturedRequest] = []
+
+    async def _gateway_handler(request: web.Request) -> web.Response:
+        body = await request.read()
+        captured.append(_CapturedRequest(
+            method=request.method,
+            path=request.path,
+            query=request.query_string,
+            headers=dict(request.headers),
+            body=body,
+        ))
+        return web.json_response({"email": "u@catfish.dev", "role": "admin"})
+
+    gateway_runner, gateway_url = await _start_fake_gateway(_gateway_handler)
+    adapter = _make_adapter(api_key="test-key")
+    server_runner, hermes_url = await _start_adapter(adapter)
+
+    try:
+        import aiohttp
+        with patch.dict("os.environ", {
+            "HERMES_SERVICE_TOKEN": "service-token-xyz",
+            "HERMES_DEFAULT_USER": "u@catfish.dev",
+            "CATFISH_GATEWAY_BASE_URL": gateway_url,
+        }, clear=False):
+            async with aiohttp.ClientSession() as session:
+                async with session.get(
+                    f"{hermes_url}/api/me",
+                    headers={"Authorization": "Bearer test-key"},
+                ) as resp:
+                    assert resp.status == 200
+                    j = await resp.json()
+                    assert j == {"email": "u@catfish.dev", "role": "admin"}
+        assert len(captured) == 1
+        c = captured[0]
+        assert c.method == "GET"
+        assert c.path == "/api/me"
+        # Service token swap
+        assert c.headers.get("Authorization") == "Bearer service-token-xyz"
+        # User attribution
+        assert c.headers.get("X-Catfish-User") == "u@catfish.dev"
+        # Proxy marker
+        assert c.headers.get("X-Forwarded-By") == "hermes-api-server"
+    finally:
+        await server_runner.cleanup()
+        await gateway_runner.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_proxy_rejects_unknown_path():
+    adapter = _make_adapter(api_key="test-key")
