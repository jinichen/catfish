+    # ------------------------------------------------------------------
+    # Catfish companion-proxy (BL-AUTH-DECOUPLE-A5)
+    #
+    # Companion historically hit catfish-gateway (8999) directly for every
+    # non-chat endpoint (/api/me, /v1/catalog, /v1/mcp/*, /api/learn/*, ...)
+    # using a per-user JWT. That JWT expires hourly and Companion sometimes
+    # doesn't refresh in time, producing the 401 storm we've been chasing.
+    #
+    # A5 collapses that surface: Companion talks to hermes only. Hermes
+    # re-issues those requests to catfish-gateway using the service token
+    # (same plumbing as A2 chat path) and forwards the end-user email via
+    # X-Catfish-User so audit/quota remain attributed correctly.
+    #
+    # Routing model:
+    #   • Hermes's own first-party routes are registered first in connect()
+    #     and aiohttp matches them first.
+    #   • This catch-all sits LAST and only matches under a narrow prefix
+    #     allowlist (/api/, /v1/, /a2a/, /healthz). Anything outside still
+    #     404s exactly like before.
+    #   • Auth: same _check_auth(API_SERVER_KEY) as every other endpoint.
+    #     Without a valid bearer the proxy never reaches catfish-gateway.
+    #
+    # Streaming: aiohttp's iter_chunked + StreamResponse keeps SSE
+    # (event-stream) live — we never buffer the body. Used by /a2a/ask and
+    # any future SSE endpoint backed by gateway.
+    # ------------------------------------------------------------------
+
+    # Prefixes Companion is allowed to reach via the proxy. Anything outside
+    # this allowlist 404s instead of leaking arbitrary upstream URLs.
+    _PROXY_ALLOWED_PREFIXES = ("/api/", "/v1/", "/a2a/", "/healthz")
+
+    # Headers we MUST NOT forward downstream (hop-by-hop per RFC 7230 +
+    # auth/host which we replace ourselves).
+    _PROXY_STRIP_REQUEST_HEADERS = frozenset({
+        "host",
+        "authorization",
+        "x-catfish-user",         # we recompute via _extract_catfish_outgoing_user
+        "content-length",         # aiohttp sets this on the outbound side
+        "connection",
+        "keep-alive",
+        "proxy-authenticate",
+        "proxy-authorization",
+        "te",
+        "trailer",
+        "transfer-encoding",
+        "upgrade",
+        # Browser-injected — meaningless / harmful to forward
+        "origin",
+        "referer",
+        "cookie",
+    })
+
+    _PROXY_STRIP_RESPONSE_HEADERS = frozenset({
+        "content-length",         # we restream; aiohttp will set its own
+        "transfer-encoding",
+        "connection",
+        "keep-alive",
+        # Strip upstream CORS — we re-apply our own based on Origin so
+        # Companion's tauri:// origin works even if gateway didn't allow it.
+        "access-control-allow-origin",
+        "access-control-allow-credentials",
+        "access-control-allow-headers",
+        "access-control-allow-methods",
+        "access-control-expose-headers",
+        "access-control-max-age",
+        "vary",
+    })
+
+    def _catfish_gateway_base_url(self) -> str:
+        """Return the catfish-gateway base URL (no /v1 suffix).
+
+        Pulled from the same place hermes already uses for chat completions:
+        model.base_url in config.yaml (e.g. ``http://localhost:8999/v1``).
+        We strip a trailing ``/v1`` segment so endpoints like ``/api/me`` and
+        ``/healthz`` resolve to the right host root.
+
+        Override via env ``CATFISH_GATEWAY_BASE_URL`` for tests / non-default
+        deployments.
+        """
+        explicit = os.environ.get("CATFISH_GATEWAY_BASE_URL", "").strip()
+        if explicit:
+            return explicit.rstrip("/")
+        try:
+            from gateway.run import _resolve_runtime_agent_kwargs
+            runtime = _resolve_runtime_agent_kwargs()
+            base = str(runtime.get("base_url") or "").rstrip("/")
+        except Exception as exc:  # pragma: no cover - fail-safe
+            logger.warning("[proxy] failed to resolve gateway base_url: %s", exc)
+            base = ""
+        if base.endswith("/v1"):
+            base = base[:-3]
+        return base or "http://127.0.0.1:8999"
+
+    @classmethod
+    def _path_is_proxyable(cls, path: str) -> bool:
+        """Return True iff *path* starts with an allowed proxy prefix."""
+        if not path:
+            return False
+        # Normalise to a single leading slash; aiohttp gives us that already
+        # but defensive against future routing tweaks.
+        if not path.startswith("/"):
+            path = "/" + path
+        for prefix in cls._PROXY_ALLOWED_PREFIXES:
+            if path.startswith(prefix):
+                return True
+        return False
+
+    def _build_proxy_request_headers(
+        self,
+        request: "web.Request",
+        outgoing_user: str,
+    ) -> Dict[str, str]:
+        """Build the header dict forwarded to catfish-gateway.
+
+        Drops hop-by-hop + auth headers, swaps in the service token, and
+        sets X-Catfish-User to the resolved end-user email.
+        """
+        out: Dict[str, str] = {}
+        for key, value in request.headers.items():
+            if key.lower() in self._PROXY_STRIP_REQUEST_HEADERS:
+                continue
+            out[key] = value
+        service_token = os.environ.get("HERMES_SERVICE_TOKEN", "").strip()
+        if service_token:
+            out["Authorization"] = f"Bearer {service_token}"
+        if outgoing_user:
+            out["X-Catfish-User"] = outgoing_user
+        # Identify the proxy hop for upstream logs / debugging.
+        out.setdefault("X-Forwarded-By", "hermes-api-server")
+        return out
+
+    def _filter_proxy_response_headers(self, raw: Any) -> Dict[str, str]:
+        """Subset of upstream response headers safe to relay to the client."""
+        out: Dict[str, str] = {}
+        try:
+            items = raw.items()
+        except AttributeError:
+            return out
+        for key, value in items:
+            if key.lower() in self._PROXY_STRIP_RESPONSE_HEADERS:
+                continue
+            out[key] = value
+        return out
+
+    async def _handle_companion_proxy(self, request: "web.Request") -> "web.StreamResponse":
+        """Catch-all proxy for Companion → catfish-gateway calls.
+
+        Behaviour:
+          1. Auth via API_SERVER_KEY (same as every other route).
+          2. Path prefix allowlist — reject anything outside /api/, /v1/,
+             /a2a/, /healthz to keep the attack surface bounded.
+          3. Re-issue the request to catfish-gateway with:
+                Authorization: Bearer ${HERMES_SERVICE_TOKEN}
+                X-Catfish-User: <end-user email>
+                <original headers minus hop-by-hop / auth / host>
+          4. Stream the response back chunk-by-chunk so SSE
+             (text/event-stream) bodies preserve their incremental shape.
+          5. Apply hermes's CORS headers based on Origin so Companion's
+             tauri:// origin works uniformly.
+        """
+        # OPTIONS preflight — handled by cors_middleware before we ever get
+        # here for known routes. For the catch-all we still need to answer
+        # explicitly so the browser doesn't see a 405.
+        if request.method == "OPTIONS":
+            origin = request.headers.get("Origin", "")
+            cors = self._cors_headers_for_origin(origin) if origin else None
+            if cors is not None:
+                return web.Response(status=204, headers=cors)
+            return web.Response(status=204)
+
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+
+        path = request.rel_url.path
+        if not self._path_is_proxyable(path):
+            return web.json_response(
+                _openai_error(f"Not found: {path}", err_type="invalid_request_error", code="not_found"),
+                status=404,
+            )
+
+        outgoing_user = self._extract_catfish_outgoing_user(request)
+        gateway_base = self._catfish_gateway_base_url()
+        # Preserve query string verbatim (path_qs includes the "?...").
+        upstream_url = f"{gateway_base}{request.rel_url.path_qs}"
+        out_headers = self._build_proxy_request_headers(request, outgoing_user)
+
+        # Read body once (small payloads) — keep raw bytes so we don't
+        # accidentally re-encode JSON. iter_chunked uses streaming on the
+        # response side, which is what matters for SSE.
+        body_bytes: Optional[bytes]
+        if request.method in {"GET", "HEAD", "DELETE", "OPTIONS"}:
+            body_bytes = None
+        else:
+            try:
+                body_bytes = await request.read()
+            except Exception as exc:
+                logger.warning("[proxy] failed to read body for %s %s: %s", request.method, path, exc)
+                return web.json_response(
+                    _openai_error("Could not read request body for proxy", err_type="invalid_request_error"),
+                    status=400,
+                )
+
+        # aiohttp imported at module top inside the try/except. Build a
+        # short-lived ClientSession per call — overhead is negligible (Python
+        # connection reuse via keep-alive lives below the session) and we
+        # avoid lifecycle hassle when the platform restarts.
+        try:
+            import aiohttp as _aiohttp
+        except ImportError:  # pragma: no cover - api_server guards this
+            return web.json_response(
+                _openai_error("aiohttp unavailable", err_type="server_error"),
+                status=500,
+            )
+
+        # No global timeout — gateway endpoints span quick reads (/api/me)
+        # and long-running SSE (/a2a/ask). Total timeout would kill the SSE.
+        # sock_connect/sock_read give us a sane connect-time guard without
+        # capping in-flight idle. Companion sets its own client timeouts.
+        timeout = _aiohttp.ClientTimeout(total=None, sock_connect=10.0, sock_read=None)
+
+        origin = request.headers.get("Origin", "")
+        cors = self._cors_headers_for_origin(origin) if origin else None
+
+        try:
+            session = _aiohttp.ClientSession(timeout=timeout)
+        except Exception as exc:  # pragma: no cover
+            logger.error("[proxy] could not create upstream session: %s", exc)
+            return web.json_response(
+                _openai_error("Upstream session create failed", err_type="server_error"),
+                status=502,
+            )
+
+        upstream_resp = None
+        try:
+            upstream_resp = await session.request(
+                method=request.method,
+                url=upstream_url,
+                headers=out_headers,
+                data=body_bytes,
+                allow_redirects=False,
+            )
+        except _aiohttp.ClientConnectorError as exc:
+            await session.close()
+            logger.warning("[proxy] connect to %s failed: %s", upstream_url, exc)
+            return web.json_response(
+                _openai_error(f"Upstream connect failed: {exc}", err_type="server_error"),
+                status=502,
+            )
+        except Exception as exc:
+            await session.close()
+            logger.error("[proxy] upstream request failed: %s", exc, exc_info=True)
+            return web.json_response(
+                _openai_error(f"Upstream request error: {exc}", err_type="server_error"),
+                status=502,
+            )
+
+        try:
+            # Prepare the streaming response to the original client. We use
+            # StreamResponse so SSE chunks land immediately; non-stream
+            # endpoints just write one chunk and end.
+            resp_headers = self._filter_proxy_response_headers(upstream_resp.headers)
+            if cors:
+                resp_headers.update(cors)
+            client_resp = web.StreamResponse(
+                status=upstream_resp.status,
+                reason=upstream_resp.reason,
+                headers=resp_headers,
+            )
+            await client_resp.prepare(request)
+            try:
+                async for chunk in upstream_resp.content.iter_chunked(16384):
+                    if not chunk:
+                        continue
+                    await client_resp.write(chunk)
+            except (asyncio.CancelledError, ConnectionResetError):
+                # Client went away — nothing to do but unwind cleanly.
+                raise
+            except Exception as exc:
+                logger.warning("[proxy] stream relay error for %s: %s", path, exc)
+            await client_resp.write_eof()
+            return client_resp
+        finally:
+            try:
+                if upstream_resp is not None:
+                    upstream_resp.release()
+            except Exception:
+                pass
+            try:
+                await session.close()
+            except Exception:
+                pass
+
