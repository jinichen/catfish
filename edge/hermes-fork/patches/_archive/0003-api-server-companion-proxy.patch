+@pytest.mark.asyncio
+async def test_proxy_streams_sse_event_stream():
+    """SSE upstream responses must be relayed chunk-by-chunk (not buffered)."""
+
+    async def _gateway_handler(request: web.Request) -> web.StreamResponse:
+        resp = web.StreamResponse(
+            status=200,
+            headers={"Content-Type": "text/event-stream"},
+        )
+        await resp.prepare(request)
+        for i in range(3):
+            await resp.write(f"data: msg-{i}\n\n".encode())
+            await asyncio.sleep(0.01)
+        await resp.write_eof()
+        return resp
+
+    gateway_runner, gateway_url = await _start_fake_gateway(_gateway_handler)
+    adapter = _make_adapter(api_key="test-key")
+    server_runner, hermes_url = await _start_adapter(adapter)
+    try:
+        import aiohttp
+        with patch.dict("os.environ", {
+            "HERMES_SERVICE_TOKEN": "svc",
+            "HERMES_DEFAULT_USER": "u@catfish.dev",
+            "CATFISH_GATEWAY_BASE_URL": gateway_url,
+        }, clear=False):
+            async with aiohttp.ClientSession() as session:
+                async with session.get(
+                    f"{hermes_url}/a2a/ask",
+                    headers={"Authorization": "Bearer test-key"},
+                ) as resp:
+                    assert resp.status == 200
+                    assert resp.headers.get("Content-Type", "").startswith("text/event-stream")
+                    received = []
+                    async for chunk in resp.content.iter_any():
+                        received.append(chunk.decode())
+                        if sum(len(c) for c in received) >= len("data: msg-0\n\ndata: msg-1\n\ndata: msg-2\n\n"):
+                            break
+        full = "".join(received)
+        assert "data: msg-0" in full
+        assert "data: msg-1" in full
+        assert "data: msg-2" in full
+    finally:
+        await server_runner.cleanup()
+        await gateway_runner.cleanup()
+
