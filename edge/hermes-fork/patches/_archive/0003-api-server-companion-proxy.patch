+@pytest.mark.asyncio
+async def test_proxy_rejects_without_api_key():
+    """Without a valid API_SERVER_KEY the proxy must not reach upstream."""
+    upstream_hits: List[int] = []
+
+    async def _gateway_handler(request: web.Request) -> web.Response:
+        upstream_hits.append(1)
+        return web.Response(text="boom")
+
+    gateway_runner, gateway_url = await _start_fake_gateway(_gateway_handler)
+    adapter = _make_adapter(api_key="test-key")
+    server_runner, hermes_url = await _start_adapter(adapter)
+    try:
+        import aiohttp
+        with patch.dict("os.environ", {
+            "HERMES_SERVICE_TOKEN": "service-token-xyz",
+            "CATFISH_GATEWAY_BASE_URL": gateway_url,
+        }, clear=False):
+            async with aiohttp.ClientSession() as session:
+                async with session.get(f"{hermes_url}/api/me") as resp:
+                    assert resp.status == 401
+                # Wrong key
+                async with session.get(
+                    f"{hermes_url}/api/me",
+                    headers={"Authorization": "Bearer wrong"},
+                ) as resp:
+                    assert resp.status == 401
+        assert upstream_hits == []
+    finally:
+        await server_runner.cleanup()
+        await gateway_runner.cleanup()
