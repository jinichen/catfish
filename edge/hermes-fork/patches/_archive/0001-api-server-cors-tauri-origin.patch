+    # ------------------------------------------------------------------
+    # Catfish auth-decouple — extract the end-user email so it can be
+    # forwarded to the upstream gateway as `X-Catfish-User`. The hermes
+    # API server's own auth (Bearer == API_SERVER_KEY) is unchanged.
+    #
+    # BL-AUTH-DECOUPLE-A2 (5/19): hermes now talks to catfish-gateway
+    # using a long-lived service token (sub=client:hermes-cli) instead
+    # of the per-user JWT. To keep audit/quota correct, hermes forwards
+    # the caller's identity in `X-Catfish-User`. Resolution order:
+    #   1. JWT `sub` claim from the incoming Authorization Bearer (works
+    #      once Companion ships A3 — passes the user's portal JWT).
+    #   2. Explicit `X-Catfish-User` header on the incoming request.
+    #   3. `HERMES_DEFAULT_USER` env var (test harness / single-tenant
+    #      installs that haven't shipped A3 yet).
+    # Returns "" when no candidate is found; downstream then sends no
+    # header and the gateway will reject the service-token request with
+    # 400, surfacing the misconfig instead of charging it to nobody.
+    # ------------------------------------------------------------------
+
+    _EMAIL_LIKE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
+
+    @staticmethod
+    def _decode_jwt_sub(token: str) -> str:
+        """Decode JWT payload (no signature verification) and return ``sub``.
+
+        Returns "" on any failure. We don't verify because:
+          - hermes is not the JWT issuer (catfish-gateway is) and rotating
+            keys here would duplicate gateway logic and drift.
+          - the JWT was already accepted by ``_check_auth`` upstream (or
+            else we wouldn't be running). Forwarding sub is a best-effort
+            attribution hint, not an authorization decision.
+        """
+        if not token or token.count(".") != 2:
+            return ""
+        try:
+            import base64 as _b64
+            import json as _json
+            payload_b64 = token.split(".")[1]
+            payload_b64 += "=" * (-len(payload_b64) % 4)
+            payload = _json.loads(_b64.urlsafe_b64decode(payload_b64))
+            sub = payload.get("sub") or payload.get("email") or ""
+            return str(sub) if sub else ""
+        except Exception:
+            return ""
+
+    def _extract_catfish_outgoing_user(self, request: "web.Request") -> str:
+        """Resolve the end-user email to forward as ``X-Catfish-User``.
+
+        See class-level comment above for resolution order. Always returns
+        a string (possibly empty) — never raises.
+        """
+        # 1. JWT sub
+        auth_header = request.headers.get("Authorization", "")
+        if auth_header.lower().startswith("bearer "):
+            token = auth_header[7:].strip()
+            sub = self._decode_jwt_sub(token)
+            if sub and self._EMAIL_LIKE.match(sub):
+                return sub
+        # 2. Explicit pass-through header from Companion
+        explicit = request.headers.get("X-Catfish-User", "").strip()
+        if explicit and self._EMAIL_LIKE.match(explicit):
+            return explicit
+        # 3. Env fallback (single-tenant / pre-A3 testing)
+        fallback = os.environ.get("HERMES_DEFAULT_USER", "").strip()
+        if fallback and self._EMAIL_LIKE.match(fallback):
+            return fallback
+        return ""
+
