+    def _is_catfish_gateway_url(self, base_url: str) -> bool:
+        """Return True when *base_url* looks like a local catfish-gateway.
+
+        Recognised by (a) hostname in the explicit env var
+        ``CATFISH_GATEWAY_HOSTS`` (comma-separated), or (b) host being
+        ``localhost``/``127.0.0.1``/``::1`` AND port in 8990–8999. This
+        keeps the header off real OpenAI / OpenRouter / proxy hops while
+        still catching the deployment defaults (gateway on 8999) and
+        common dev ports. Override via env when shipping a non-default
+        port.
+        """
+        if not base_url:
+            return False
+        try:
+            from urllib.parse import urlparse
+            parsed = urlparse(base_url)
+            host = (parsed.hostname or "").lower()
+            port = parsed.port
+        except Exception:
+            return False
+        explicit_hosts = [
+            h.strip().lower()
+            for h in os.environ.get("CATFISH_GATEWAY_HOSTS", "").split(",")
+            if h.strip()
+        ]
+        if explicit_hosts and host in explicit_hosts:
+            return True
+        if host in {"localhost", "127.0.0.1", "::1"} and port and 8990 <= port <= 8999:
+            return True
+        return False
+
+    def _inject_catfish_outgoing_user_header(self, request_kwargs: dict) -> None:
+        """Merge ``X-Catfish-User`` into request_kwargs['default_headers']
+        when the upstream is a catfish-gateway URL.
+
+        Safe no-op when:
+          - ``self._catfish_outgoing_user`` is unset/empty (CLI runs, non
+            api_server platforms, or env fallback unset),
+          - the upstream isn't a catfish-gateway-shaped URL (regular
+            OpenAI / OpenRouter / Anthropic targets),
+          - ``default_headers`` already has the key (caller wins).
+
+        Mutates *request_kwargs* in place.
+        """
+        user = getattr(self, "_catfish_outgoing_user", "") or ""
+        if not user:
+            return
+        if not self._is_catfish_gateway_url(str(request_kwargs.get("base_url", ""))):
+            return
+        existing = request_kwargs.get("default_headers") or {}
+        # Normalise to a plain dict — OpenAI SDK accepts dict-like, but we
+        # need to merge without trampling callers (copilot vision path).
+        if not isinstance(existing, dict):
+            try:
+                existing = dict(existing)
+            except Exception:
+                existing = {}
+        if "X-Catfish-User" in existing:
+            return
+        merged = dict(existing)
+        merged["X-Catfish-User"] = user
+        request_kwargs["default_headers"] = merged
+
     def _close_request_openai_client(self, client: Any, *, reason: str) -> None:
         self._close_openai_client(client, reason=reason, shared=False)
 
