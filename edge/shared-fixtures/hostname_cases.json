{
  "_why": [
    "Rust (Companion 存密码) 和 Python (tool-bridge 查密码) 各有一份 hostname 归一化。",
    "两边判据一旦漂开, 表现是【员工存了, 教学还是说没存过】—— 存进去的 key 和查的 key",
    "对不上, 而两边各自看都正常。这正是 8/17 那个 bug 的形状 (那次漂的是 secret_ref)。",
    "所以判据只有这一份, 两边测试都读它。改判据 = 改这个文件, 两边一起红。",
    "",
    "expect 为空串 = 不是站点。Rust 侧对应 Err, Python 侧对应 \"\"。"
  ],
  "cases": [
    {"in": "http://eis.ffcs.cn/cas/login?service=x", "expect": "eis.ffcs.cn", "note": "最常见: 带路径和 query"},
    {"in": "https://eis.ffcs.cn",                    "expect": "eis.ffcs.cn"},
    {"in": "https://EIS.FFCS.CN/",                   "expect": "eis.ffcs.cn", "note": "大小写归一"},
    {"in": "http://eis.ffcs.cn:8080/x",              "expect": "eis.ffcs.cn", "note": "端口不属于站点"},
    {"in": "http://eis.ffcs.cn.",                    "expect": "eis.ffcs.cn.", "note": "★ 带根点的 FQDN 两边都原样留着 — 谁也别偷偷剥"},
    {"in": "eis.ffcs.cn",                            "expect": "eis.ffcs.cn", "note": "裸 host"},
    {"in": "  eis.ffcs.cn  ",                        "expect": "eis.ffcs.cn", "note": "员工粘贴常带空白"},
    {"in": "NEIS.ffcs.cn",                           "expect": "neis.ffcs.cn"},
    {"in": "www.ffcs.cn",                            "expect": "www.ffcs.cn", "note": "★ 不剥 www. — 两个 host 就是两个"},
    {"in": "ffcs.cn",                                "expect": "ffcs.cn",     "note": "★ 跟上一条必须不同"},
    {"in": "192.168.1.10",                           "expect": "192.168.1.10", "note": "内网系统常直接用 IP"},
    {"in": "http://192.168.1.10:8080/oa",            "expect": "192.168.1.10"},

    {"in": "EIS",                                    "expect": "", "note": "★★ 员工起的名字, 不是站点"},
    {"in": "教学登录",                                "expect": "", "note": "★★ 同上"},
    {"in": "公司 OA 系统",                            "expect": "", "note": "带空格更不能当 host"},
    {"in": "eis ffcs cn",                            "expect": "", "note": "空格分隔的不是 host"},
    {"in": "some/path",                              "expect": "", "note": "有斜杠但没 scheme — 判不了"},
    {"in": "",                                       "expect": ""},
    {"in": "   ",                                    "expect": ""},
    {"in": "localhost",                              "expect": "", "note": "★ 单标签没有点 — 判据是含 '.'。要用得写 localhost. 或带 scheme"},
    {"in": "http://localhost:9222/",                 "expect": "localhost", "note": "带 scheme 就能确定, 这条通"},
    {"in": "keychain://catfish-teaching:EIS",        "expect": "", "note": "★★★ 引用串不是站点。urlparse 会把 catfish-teaching 当 host 且不报错 — 判据必须限定 http/https"},
    {"in": "keychain://catfish-teaching:http://eis.ffcs.cn", "expect": "", "note": "★★★ 8/17 那条坏 label 的原样。宽判据会给它配一个假站点 catfish-teaching"},
    {"in": "wincred://catfish-teaching:EIS",         "expect": "", "note": "Windows 侧同理"},
    {"in": "env://EIS_PASSWORD",                     "expect": ""},
    {"in": "ftp://eis.ffcs.cn",                      "expect": "", "note": "浏览器地址栏只可能是 http/https, 别的一律不认"},
    {"in": "file:///Users/x/a.html",                 "expect": ""},
    {"in": "http://",                                "expect": "", "note": "有 scheme 没 host"}
  ]
}
