#!/usr/bin/env bash
# catfish · 鲶鱼平台员工入口命令
#
# 替代直接敲 hermes：先打鲶鱼 banner、检查环境、然后 exec 到真正的 hermes。
# 员工心智里"敲 catfish"就是进入鲶鱼平台，跟"敲 hermes"切割开。
#
# 用法：
#     catfish                    # 进交互式 hermes
#     catfish --no-banner        # 跳过启动横幅
#     catfish --raw              # 直接调底层 hermes（不做任何包装）
#     catfish chat ...           # 透传给 hermes 子命令
#
# 特殊命令（catfish 自有的，不透传给 hermes）：
#     catfish status             # 看鲶鱼平台整体状态（gateway / chrome / 索引 / Hermes）
#     catfish version            # 看 catfish 版本
#     catfish doctor             # 自检（依赖 / 配置 / 服务）
#

set -euo pipefail

# ---------- 配置 ----------

# 版本号: 5/5 鸿波"是不是硬编码"修, 改读 Companion package.json (跟 Tauri 同步源).
# 找不到 fallback "0.1.0+local" 让员工知道是 dev 装/没找到.
_resolve_catfish_version() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local d="$script_dir"
    while [ "$d" != "/" ]; do
        local pkg="$d/edge/companion-app/package.json"
        if [ -f "$pkg" ]; then
            # macOS BSD sed 不支持 \K, 用 awk 抽 "version": "x.y.z"
            local v
            v="$(awk -F'"' '/"version"[[:space:]]*:/ {print $4; exit}' "$pkg" 2>/dev/null)"
            if [ -n "$v" ]; then
                echo "$v"
                return 0
            fi
        fi
        d="$(dirname "$d")"
    done
    echo "0.1.0+local"
}
CATFISH_VERSION="${CATFISH_VERSION:-$(_resolve_catfish_version)}"
CATFISH_HOME="${CATFISH_HOME:-$HOME/.catfish}"
HERMES_BIN="${HERMES_BIN:-hermes}"

# 端口 / 主机（跟 Companion services::endpoints + feishu config 同名约定）
CATFISH_GATEWAY_HOST="${CATFISH_GATEWAY_HOST:-127.0.0.1}"
CATFISH_GATEWAY_PORT="${CATFISH_GATEWAY_PORT:-8999}"
CATFISH_CHROME_DEBUG_HOST="${CATFISH_CHROME_DEBUG_HOST:-127.0.0.1}"
CATFISH_CHROME_DEBUG_PORT="${CATFISH_CHROME_DEBUG_PORT:-9222}"

# brand patch 自愈相关 (B.3 五一 sprint 5/5)
CATFISH_REPO_ROOT="${CATFISH_REPO_ROOT:-}"  # 不设则启动时自动定位
CATFISH_BRAND_PATCH_AUTO_HEAL="${CATFISH_BRAND_PATCH_AUTO_HEAL:-1}"  # 1=自动 re-apply, 0=只警告

# ---------- 代理环境净化 ----------
# 背景: hermes 的 httpx client 只看 HTTPS_PROXY (无视 NO_PROXY), 员工 shell 里
#       常设 HTTPS_PROXY=127.0.0.1:7890 (Clash/Mihomo) → hermes 把"调网关"的
#       请求劫到代理上, 反正 7890 不知道怎么转发到 8999, 直接 connection refused。
# 决策: 敲 catfish 时把代理 env 全 unset 再 exec hermes。
#       gateway 是 localhost, 不需要代理。 gateway 自己内部调上游公网 LLM (Gemini
#       等) 时它的 network.py 会按需走代理, 跟 hermes 这边的 env 无关。
# 影响范围: 只影响 hermes 子进程, 不动 shell。Git / 浏览器 / 等照常走代理。
# 留逃生口: 设 CATFISH_KEEP_PROXY=1 关掉这个净化 (调试 / 极端场景)。
nuke_proxy_for_hermes() {
    if [ -n "${CATFISH_KEEP_PROXY:-}" ]; then
        return 0
    fi
    unset HTTPS_PROXY HTTP_PROXY ALL_PROXY
    unset https_proxy http_proxy all_proxy
}

# ---------- 终端 skin 自动修 ----------
# 背景: 4-25 给 hermes 装了"象牙白"等 catfish 品牌 skin, 但 skin 是按"哪种终端
#       背景"设计的. 浅色终端用 daylight 风格, 深色终端 (Homebrew/Pro/Solarized)
#       看不清字. 已知员工切终端 profile 后, 旧 skin 就跟新背景对不上了.
# 决策: catfish 启动时把 ~/.hermes/config.yaml 的 skin 强制设为 default, 这个
#       skin 是 hermes 通用的、跨深浅终端配色都可读的. 想保留品牌 skin 的员工
#       设 CATFISH_BRAND_SKIN=1 跳过. 想用别的 skin 设 CATFISH_DEFAULT_SKIN=<name>.
# 容错: 写 yaml 失败不阻塞 hermes 启动. 配置不存在或没 skin 字段都直接退出.
# 不动: shell 不变. 只动 ~/.hermes/config.yaml 的 skin 一个字段.
ensure_skin() {
    if [ -n "${CATFISH_BRAND_SKIN:-}" ]; then
        return 0
    fi
    local target_skin="${CATFISH_DEFAULT_SKIN:-default}"
    local hermes_config="$HOME/.hermes/config.yaml"
    [ -f "$hermes_config" ] || return 0

    # 用 Python yaml 安全更新 (sed/awk 容易破坏其它字段)
    # 错误静默 — skin 修不上不影响 hermes 启动
    # 注: hermes config schema 里 skin 嵌套在 display.skin, 不是顶层
    python3 - "$hermes_config" "$target_skin" 2>/dev/null <<'PY' || true
import sys
try:
    import yaml
except ImportError:
    sys.exit(0)  # PyYAML 没装就跳过, 用户手动 /skin <name> --global

config_path, target = sys.argv[1], sys.argv[2]
try:
    with open(config_path, "r", encoding="utf-8") as f:
        data = yaml.safe_load(f) or {}
    display = data.get("display")
    if not isinstance(display, dict):
        # 没 display 段 → hermes 用全部内置默认, 不画蛇添足
        sys.exit(0)
    current = display.get("skin")
    if current == target:
        sys.exit(0)
    if current is None:
        # display 段在但没 skin 字段 → 同样不强加, 让 hermes 内置默认走
        sys.exit(0)
    display["skin"] = target
    with open(config_path, "w", encoding="utf-8") as f:
        yaml.safe_dump(data, f, allow_unicode=True, default_flow_style=False, sort_keys=False)
except Exception:
    pass
PY
}

# ---------- brand patch 自愈 (B.3 五一 sprint 5/5) ----------
# 背景: hermes 升级 (0.10 → 0.12 等) 后, ~/.hermes/hermes-agent 内容被替换,
#       apply_brand_patch.py 之前 patch 过的字串又恢复成 "Hermes Agent" / "Nous Research".
#       员工敲 catfish 第一次, 看到 hermes 字眼 = brand 泄漏.
# 方案: 启动前跑 hermes_brand_check.sh, fail 时自动调 apply_brand_patch.py --apply
#       让员工无感的 self-heal. 升级后第一次启动多 1-2 秒, 之后 NOOP (patch 已 apply).
# 容错:
#   - check 脚本不存在 / patch 脚本不存在 → 跳过 (不阻塞启动)
#   - re-apply 后还 fail → 警告员工但不阻塞 (员工能进 hermes, 只是会看到 brand 字眼)
#   - CATFISH_BRAND_PATCH_AUTO_HEAL=0 → 只 check 不 apply (CI/admin 场景)
# 性能: brand check 全 grep, 28 个 file 总 < 100KB, 100ms 量级. 不显著拖慢启动.

# 定位 catfish 仓库根 (含 edge/hermes-fork/apply_brand_patch.py)
locate_catfish_repo() {
    if [ -n "$CATFISH_REPO_ROOT" ] && [ -d "$CATFISH_REPO_ROOT/edge/hermes-fork" ]; then
        echo "$CATFISH_REPO_ROOT"
        return 0
    fi
    # 从这个脚本所在目录往上找
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local d="$script_dir"
    while [ "$d" != "/" ]; do
        if [ -d "$d/edge/hermes-fork" ] && [ -d "$d/tests" ]; then
            echo "$d"
            return 0
        fi
        d="$(dirname "$d")"
    done
    # 找不到
    return 1
}

ensure_brand_patch() {
    local repo
    if ! repo="$(locate_catfish_repo)"; then
        return 0  # 找不到仓库 (员工可能装的二进制版, 不是源码克隆), 跳过
    fi

    local check_sh="$repo/tests/hermes_brand_check.sh"
    local patch_py="$repo/edge/hermes-fork/apply_brand_patch.py"

    [ -f "$check_sh" ] || return 0
    [ -f "$patch_py" ] || return 0
    command -v python3 >/dev/null 2>&1 || return 0

    # 跑 check (静默)
    if HERMES_DIR="${HERMES_DIR:-$HOME/.hermes/hermes-agent}" bash "$check_sh" >/dev/null 2>&1; then
        return 0  # patch 状态 OK, NOOP
    fi

    # check 失败 → 看是不是要自愈
    if [ "$CATFISH_BRAND_PATCH_AUTO_HEAL" = "0" ]; then
        echo "${YELLOW:-}brand patch 漂移. 跑 catfish brand-fix 修复, 或 unset CATFISH_BRAND_PATCH_AUTO_HEAL 让 catfish 自动修.${RESET:-}" >&2
        return 0
    fi

    # 自动 re-apply
    echo "${DIM:-}brand patch 漂移 (hermes 升级了?), 自动修中…${RESET:-}" >&2
    if python3 "$patch_py" --apply >/dev/null 2>&1; then
        # re-apply 后再 check 一次确认
        if HERMES_DIR="${HERMES_DIR:-$HOME/.hermes/hermes-agent}" bash "$check_sh" >/dev/null 2>&1; then
            echo "${GREEN:-}brand patch 已自愈.${RESET:-}" >&2
            return 0
        fi
    fi

    # re-apply 失败 / re-apply 后 check 仍 fail
    echo "${YELLOW:-}brand patch 自愈失败. hermes 可能又升级了, RULES 需更新." >&2
    echo "诊断: bash $check_sh 看哪条 FAIL.${RESET:-}" >&2
    return 0  # 不阻塞启动 — 员工能进 hermes, 只是会看到部分 hermes 字眼
}

# ---------- 颜色（可被 NO_COLOR / 非 tty 关掉）----------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    # 用 $'...' (C-style escape) 让变量真正含 ESC 字符，
    # 这样 echo 和 cat heredoc 不需要 -e 也能输出彩色。
    BOLD=$'\033[1m';  DIM=$'\033[2m';  CYAN=$'\033[36m';  YELLOW=$'\033[33m'
    GREEN=$'\033[32m';  RESET=$'\033[0m'
else
    BOLD=''; DIM=''; CYAN=''; YELLOW=''; GREEN=''; RESET=''
fi

# ---------- ASCII banner ----------

banner() {
    cat <<EOF
${CYAN}${BOLD}
    ╔═══════════════════════════════════════════════╗
    ║                                               ║
    ║         🐟  鲶  鱼  ·  C A T F I S H          ║
    ║                                               ║
    ║       员工的 AI 副手 · 边缘主权 · 平等         ║
    ║                                               ║
    ╚═══════════════════════════════════════════════╝
${RESET}${DIM}    v${CATFISH_VERSION}${RESET}

EOF
}

# ---------- 子命令 ----------

cmd_version() {
    echo "catfish v${CATFISH_VERSION}"
    if command -v "$HERMES_BIN" >/dev/null 2>&1; then
        echo "underlying: $($HERMES_BIN --version 2>/dev/null | head -1 || echo "$HERMES_BIN unknown version")"
    fi
}

cmd_status() {
    echo "${BOLD}=== 鲶鱼平台状态 ===${RESET}"
    echo

    # 1. Gateway
    local gw_endpoint="${CATFISH_GATEWAY_HOST}:${CATFISH_GATEWAY_PORT}"
    echo "${BOLD}[Gateway]${RESET}"
    if curl -sSf -m 2 "http://${gw_endpoint}/health" >/dev/null 2>&1; then
        echo "    ${GREEN}OK${RESET} catfish-gateway 跑着 (${gw_endpoint})"
    else
        echo "    ${YELLOW}OFF${RESET} gateway 没起。启动：cd central/llm-gateway && python -m catfish_gateway.app"
    fi
    echo

    # 2. Catfish Chrome
    local chrome_endpoint="${CATFISH_CHROME_DEBUG_HOST}:${CATFISH_CHROME_DEBUG_PORT}"
    echo "${BOLD}[Catfish Chrome]${RESET}"
    if curl -sSf -m 2 "http://${chrome_endpoint}/json/version" >/dev/null 2>&1; then
        chrome_ver="$(curl -s "http://${chrome_endpoint}/json/version" | python3 -c "import sys,json;print(json.load(sys.stdin).get('Browser',''))" 2>/dev/null || echo unknown)"
        echo "    ${GREEN}OK${RESET} CDP ${CATFISH_CHROME_DEBUG_PORT} 通 ($chrome_ver)"
    else
        echo "    ${YELLOW}OFF${RESET} 没起。启动：bash edge/browser-agent/scripts/catfish-browser-attach.sh"
    fi
    echo

    # 3. 本地搜索
    echo "${BOLD}[Local Search]${RESET}"
    if command -v catfish-search >/dev/null 2>&1; then
        catfish-search status 2>&1 | sed 's/^/    /'
    else
        echo "    ${YELLOW}未装${RESET}  装：bash onboarding/install-catfish.sh"
    fi
    echo

    # 4. SOUL 是否接管
    echo "${BOLD}[Identity (SOUL.md)]${RESET}"
    if [ -L "$HOME/.hermes/SOUL.md" ]; then
        target="$(readlink "$HOME/.hermes/SOUL.md")"
        case "$target" in
            *catfish*identity*)
                echo "    ${GREEN}OK${RESET} catfish 已接管"
                ;;
            *)
                echo "    ${YELLOW}其他${RESET} 软链到 $target"
                ;;
        esac
    elif [ -f "$HOME/.hermes/SOUL.md" ]; then
        echo "    ${YELLOW}默认${RESET} 没装 catfish identity。装：bash edge/identity/install.sh"
    else
        echo "    ${YELLOW}缺${RESET} ~/.hermes/SOUL.md 不存在"
    fi
    echo

    # 4b. BL-HERMES-UPGRADE-PLUGIN-AUDIT (6/4): check plugin symlink + config.
    # 防 5/29 hermes 0.15.2 升级 wipe plugin install 那种情况 (上次 6 小时 audit).
    cmd_check_plugins

    # 5. Hermes 本体
    echo "${BOLD}[Hermes Runtime]${RESET}"
    if command -v "$HERMES_BIN" >/dev/null 2>&1; then
        echo "    ${GREEN}OK${RESET} $($HERMES_BIN --version 2>/dev/null | head -1 || echo "$HERMES_BIN")"
    else
        echo "    ${YELLOW}未装${RESET} 装 Hermes Agent"
    fi
}

# BL-HERMES-UPGRADE-PLUGIN-AUDIT (6/4 鸿波): 检 plugin symlink + config + launchctl env.
# 5/29 hermes 0.15.2 升级 wipe 了 catfish-memory plugin install (symlink + memory.provider 字段),
# 害 6 小时 audit 才发现根因. 这函数确保 catfish 关键 install state 完整.
cmd_check_plugins() {
    # 5a. ~/.hermes/plugins/ symlink
    echo "${BOLD}[Plugins (~/.hermes/plugins/)]${RESET}"
    _check_plugin_symlink() {
        local name="$1"
        local expected_substr="$2"
        local link_path="$HOME/.hermes/plugins/$name"
        if [ -L "$link_path" ]; then
            local target
            target="$(readlink "$link_path")"
            if [[ "$target" == *"$expected_substr"* ]]; then
                echo "    ${GREEN}OK${RESET} $name → $target"
            else
                echo "    ${YELLOW}WARN${RESET} $name → $target (target 异常, 期望含 $expected_substr)"
            fi
        else
            echo "    ${YELLOW}缺${RESET} $link_path 不存在"
            echo "         5/29 hermes 升级会 wipe 这个 symlink! 修法:"
            echo "         ln -s ~/person_task/catfish/edge/hermes-plugins/$name ~/.hermes/plugins/$name"
        fi
    }
    _check_plugin_symlink "catfish-memory" "hermes-plugins/catfish-memory"
    _check_plugin_symlink "catfish-xcatfish-user" "hermes-plugins/catfish-xcatfish-user"
    echo

    # 5b. config.yaml memory.provider 字段
    echo "${BOLD}[Config (~/.hermes/config.yaml)]${RESET}"
    if [ -f "$HOME/.hermes/config.yaml" ]; then
        if grep -qE "^\s*provider:\s*catfish-memory" "$HOME/.hermes/config.yaml"; then
            echo "    ${GREEN}OK${RESET} memory.provider: catfish-memory"
        else
            echo "    ${YELLOW}缺${RESET} memory.provider 不是 catfish-memory (默认 hermes builtin)"
            echo "         5/29 升级 reset 此字段! 修法: 在 ~/.hermes/config.yaml 真 memory: 块加"
            echo "         memory:"
            echo "           provider: catfish-memory"
        fi
    else
        echo "    ${YELLOW}缺${RESET} ~/.hermes/config.yaml 不存在"
    fi
    echo

    # 5c. CATFISH_WIKI_ENABLE env (P1.1 wiki two-step ingest 开关)
    echo "${BOLD}[Wiki Mode (CATFISH_WIKI_ENABLE)]${RESET}"
    local wiki_env
    wiki_env="$(launchctl getenv CATFISH_WIKI_ENABLE 2>/dev/null || echo '')"
    if [ "$wiki_env" = "1" ]; then
        echo "    ${GREEN}OK${RESET} CATFISH_WIKI_ENABLE=1 (wiki two-step ingest 启用)"
    else
        echo "    ${YELLOW}默认${RESET} CATFISH_WIKI_ENABLE 未设 (wiki distill 不跑, journal+legacy distill 仍写)"
        echo "         开: launchctl setenv CATFISH_WIKI_ENABLE 1 && hermes gateway stop && hermes gateway start"
    fi
    echo

    # 5d. ~/.catfish/wiki/ 目录 + counts
    echo "${BOLD}[Wiki Vault (~/.catfish/wiki/)]${RESET}"
    if [ -d "$HOME/.catfish/wiki" ]; then
        local n_ent n_con n_que
        n_ent=$(ls "$HOME/.catfish/wiki/entities" 2>/dev/null | grep -c '\.md$' || echo 0)
        n_con=$(ls "$HOME/.catfish/wiki/concepts" 2>/dev/null | grep -c '\.md$' || echo 0)
        n_que=$(ls "$HOME/.catfish/wiki/queries" 2>/dev/null | grep -c '\.md$' || echo 0)
        echo "    ${GREEN}OK${RESET} $n_ent entities · $n_con concepts · $n_que queries"
    else
        echo "    ${YELLOW}空${RESET} ~/.catfish/wiki/ 不存在 (chat 真**真**真**`💾 存 wiki` 后 触发 distill 自动生**)"
    fi
    echo

    # 5e. journal mtime + distilled facts
    echo "${BOLD}[Memory Files]${RESET}"
    local journal="$HOME/.catfish/employee_journal.md"
    if [ -f "$journal" ]; then
        local mtime size
        if command -v stat >/dev/null 2>&1; then
            mtime="$(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$journal" 2>/dev/null || stat -c '%y' "$journal" 2>/dev/null | cut -d. -f1)"
            size="$(stat -f '%z' "$journal" 2>/dev/null || stat -c '%s' "$journal" 2>/dev/null)"
            echo "    ${GREEN}OK${RESET} employee_journal.md ($size bytes, last $mtime)"
        else
            echo "    ${GREEN}OK${RESET} employee_journal.md exists"
        fi
    else
        echo "    ${YELLOW}缺${RESET} ~/.catfish/employee_journal.md (chat 真 sync_turn 触发后生)"
    fi
    local distilled="$HOME/.catfish/distilled_facts.md"
    if [ -f "$distilled" ]; then
        local size
        size="$(stat -f '%z' "$distilled" 2>/dev/null || stat -c '%s' "$distilled" 2>/dev/null)"
        echo "    ${GREEN}OK${RESET} distilled_facts.md ($size bytes)"
    else
        echo "    ${YELLOW}缺${RESET} ~/.catfish/distilled_facts.md (24h 蒸馏后生)"
    fi
}

cmd_doctor() {
    echo "${BOLD}=== 鲶鱼自检 ===${RESET}"
    cmd_status
    echo
    echo "${BOLD}[Python]${RESET}"
    if command -v python3 >/dev/null 2>&1; then
        echo "    ${GREEN}OK${RESET} $(python3 --version)"
    else
        echo "    ${YELLOW}缺${RESET} python3"
    fi
    echo
    echo "${BOLD}[路径检查]${RESET}"
    case ":$PATH:" in
        *":$HOME/.local/bin:"*)
            echo "    ${GREEN}OK${RESET} ~/.local/bin 在 PATH"
            ;;
        *)
            echo "    ${YELLOW}WARN${RESET} ~/.local/bin 不在 PATH（catfish-* 命令找不到）"
            ;;
    esac
    echo
    echo "${BOLD}[Brand patch]${RESET}"
    cmd_brand_check_quiet
}

# B.3 五一 sprint 5/5 — brand patch 手动跑入口

cmd_brand_check_quiet() {
    local repo
    if ! repo="$(locate_catfish_repo)"; then
        echo "    ${YELLOW}SKIP${RESET} 找不到 catfish 仓库根 (二进制装?)"
        return 0
    fi
    local check_sh="$repo/tests/hermes_brand_check.sh"
    if [ ! -f "$check_sh" ]; then
        echo "    ${YELLOW}缺${RESET} $check_sh 不存在"
        return 0
    fi
    if HERMES_DIR="${HERMES_DIR:-$HOME/.hermes/hermes-agent}" bash "$check_sh" >/dev/null 2>&1; then
        echo "    ${GREEN}OK${RESET} brand patch 完整, hermes 升级也安全"
    else
        echo "    ${YELLOW}WARN${RESET} brand patch 有泄漏. 跑 catfish brand-fix 修复"
    fi
}

cmd_brand_check() {
    local repo
    if ! repo="$(locate_catfish_repo)"; then
        echo "${YELLOW}找不到 catfish 仓库根. 设 CATFISH_REPO_ROOT=<path> 或在 catfish 源码内跑${RESET}" >&2
        return 1
    fi
    local check_sh="$repo/tests/hermes_brand_check.sh"
    if [ ! -f "$check_sh" ]; then
        echo "${YELLOW}缺 $check_sh${RESET}" >&2
        return 1
    fi
    HERMES_DIR="${HERMES_DIR:-$HOME/.hermes/hermes-agent}" bash "$check_sh"
}

cmd_brand_fix() {
    local repo
    if ! repo="$(locate_catfish_repo)"; then
        echo "${YELLOW}找不到 catfish 仓库根. 设 CATFISH_REPO_ROOT=<path>${RESET}" >&2
        return 1
    fi
    local patch_py="$repo/edge/hermes-fork/apply_brand_patch.py"
    if [ ! -f "$patch_py" ]; then
        echo "${YELLOW}缺 $patch_py${RESET}" >&2
        return 1
    fi
    echo "${BOLD}=== brand patch fix ===${RESET}"
    python3 "$patch_py" --apply
    echo
    echo "${BOLD}=== verify ===${RESET}"
    cmd_brand_check
}

# BL-CATFISH-WIKI-MODE P2.2 (6/4 鸿波): structural lint for ~/.catfish/wiki/.
# 扫 wiki/*.md 抽 [[wikilinks]] + frontmatter, 报 broken-link / orphan / no-outlinks.
# 0 LLM 调用. 用法: catfish lint  或  catfish lint --json
cmd_lint() {
    local repo
    if ! repo="$(locate_catfish_repo)"; then
        echo "${YELLOW}找不到 catfish 仓库根. 设 CATFISH_REPO_ROOT=<path>${RESET}" >&2
        return 1
    fi
    local script="$repo/edge/catfish-cli/scripts/lint_wiki.py"
    if [ ! -f "$script" ]; then
        echo "${YELLOW}缺 $script${RESET}" >&2
        return 1
    fi
    python3 "$script" "$@"
}

# ---------- 主分发 ----------

main() {
    # 优先识别 catfish 自有的 meta 命令（不进 Hermes）
    case "${1:-}" in
        version|-v|--version)
            cmd_version
            exit 0
            ;;
        status)
            shift
            cmd_status "$@"
            exit 0
            ;;
        doctor|self-check|check)
            shift
            cmd_doctor "$@"
            exit 0
            ;;
        brand-check)
            shift
            cmd_brand_check "$@"
            exit $?
            ;;
        brand-fix)
            shift
            cmd_brand_fix "$@"
            exit $?
            ;;
        lint)
            shift
            cmd_lint "$@"
            exit $?
            ;;
        --raw)
            shift
            nuke_proxy_for_hermes
            ensure_skin
            ensure_brand_patch
            exec "$HERMES_BIN" "$@"
            ;;
        --no-banner)
            shift
            nuke_proxy_for_hermes
            ensure_skin
            ensure_brand_patch
            exec "$HERMES_BIN" "$@"
            ;;
        -h|--help)
            cat <<EOF
${BOLD}catfish${RESET} - 鲶鱼平台员工入口

用法：
    catfish                    交互式启动（带鲶鱼 banner）
    catfish --no-banner        不打 banner 直接进 hermes
    catfish --raw              透传给底层 hermes，不加任何包装
    catfish status             看平台整体状态（gateway / Chrome / 搜索 / SOUL / Hermes）
    catfish doctor             深度自检 (含 brand patch 状态)
    catfish brand-check        手动跑 brand patch 完整性检查 (升级 hermes 后跑)
    catfish brand-fix          自动 re-apply brand patch (hermes 升级后第一次跑)
    catfish lint               扫 wiki/ 真**broken-link / orphan concept / dead-end** (--json 真**机器读**)
    catfish version            看版本
    catfish <hermes 子命令>    透传给 hermes（chat / model / mcp / sessions ...）

环境变量:
    CATFISH_KEEP_PROXY=1            不要 unset HTTPS_PROXY/HTTP_PROXY (默认 unset 防代理劫持 localhost)
    CATFISH_BRAND_SKIN=1            保留 hermes 当前 skin (默认强制 default 防深色终端不可读)
    CATFISH_DEFAULT_SKIN=<name>     自选要切的 skin 名 (默认 "default", 也可设 "dark" / "daylight" / 等)
    CATFISH_BRAND_PATCH_AUTO_HEAL=0 启动时不自动 re-apply brand patch (CI/admin 场景, 默认 1=自愈)
    CATFISH_REPO_ROOT=<path>        catfish 仓库根 (默认从脚本位置自动定位, 二进制装时设)
    CATFISH_GATEWAY_HOST            默认 127.0.0.1
    CATFISH_GATEWAY_PORT            默认 8999
    CATFISH_CHROME_DEBUG_PORT       默认 9222

一切问题先跑 catfish doctor 看哪条红 / 黄。
EOF
            exit 0
            ;;
    esac

    # 默认: 打 banner, 净化代理 env, 确保 skin 兼容当前终端, brand patch 自愈, 进入 hermes
    banner
    nuke_proxy_for_hermes
    ensure_skin
    ensure_brand_patch
    exec "$HERMES_BIN" "$@"
}

main "$@"
