#!/usr/bin/env bash
# catfish · 鲶鱼平台员工入口命令
#
# 替代直接敲 hermes：先打鲶鱼 banner、检查环境、然后 exec 到真正的 hermes。
# 员工心智里"敲 catfish"就是进入鲶鱼平台，跟"敲 hermes"切割开。
#
# 用法：
#     catfish                    # 进交互式 hermes
#     catfish --no-banner        # 跳过启动横幅
#     catfish --raw              # 直接调底层 hermes（不做任何包装）
#     catfish chat ...           # 透传给 hermes 子命令
#
# 特殊命令（catfish 自有的，不透传给 hermes）：
#     catfish status             # 看鲶鱼平台整体状态（gateway / chrome / 索引 / Hermes）
#     catfish version            # 看 catfish 版本
#     catfish doctor             # 自检（依赖 / 配置 / 服务）
#

set -euo pipefail

# ---------- 配置 ----------

CATFISH_VERSION="0.1.0"
CATFISH_HOME="${CATFISH_HOME:-$HOME/.catfish}"
HERMES_BIN="${HERMES_BIN:-hermes}"

# 端口 / 主机（跟 Companion services::endpoints + feishu config 同名约定）
CATFISH_GATEWAY_HOST="${CATFISH_GATEWAY_HOST:-127.0.0.1}"
CATFISH_GATEWAY_PORT="${CATFISH_GATEWAY_PORT:-8999}"
CATFISH_CHROME_DEBUG_HOST="${CATFISH_CHROME_DEBUG_HOST:-127.0.0.1}"
CATFISH_CHROME_DEBUG_PORT="${CATFISH_CHROME_DEBUG_PORT:-9222}"

# ---------- 代理环境净化 ----------
# 背景: hermes 的 httpx client 只看 HTTPS_PROXY (无视 NO_PROXY), 员工 shell 里
#       常设 HTTPS_PROXY=127.0.0.1:7890 (Clash/Mihomo) → hermes 把"调网关"的
#       请求劫到代理上, 反正 7890 不知道怎么转发到 8999, 直接 connection refused。
# 决策: 敲 catfish 时把代理 env 全 unset 再 exec hermes。
#       gateway 是 localhost, 不需要代理。 gateway 自己内部调上游公网 LLM (Gemini
#       等) 时它的 network.py 会按需走代理, 跟 hermes 这边的 env 无关。
# 影响范围: 只影响 hermes 子进程, 不动 shell。Git / 浏览器 / 等照常走代理。
# 留逃生口: 设 CATFISH_KEEP_PROXY=1 关掉这个净化 (调试 / 极端场景)。
nuke_proxy_for_hermes() {
    if [ -n "${CATFISH_KEEP_PROXY:-}" ]; then
        return 0
    fi
    unset HTTPS_PROXY HTTP_PROXY ALL_PROXY
    unset https_proxy http_proxy all_proxy
}

# ---------- 颜色（可被 NO_COLOR / 非 tty 关掉）----------

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    # 用 $'...' (C-style escape) 让变量真正含 ESC 字符，
    # 这样 echo 和 cat heredoc 不需要 -e 也能输出彩色。
    BOLD=$'\033[1m';  DIM=$'\033[2m';  CYAN=$'\033[36m';  YELLOW=$'\033[33m'
    GREEN=$'\033[32m';  RESET=$'\033[0m'
else
    BOLD=''; DIM=''; CYAN=''; YELLOW=''; GREEN=''; RESET=''
fi

# ---------- ASCII banner ----------

banner() {
    cat <<EOF
${CYAN}${BOLD}
    ╔═══════════════════════════════════════════════╗
    ║                                               ║
    ║         🐟  鲶  鱼  ·  C A T F I S H          ║
    ║                                               ║
    ║       员工的 AI 副手 · 边缘主权 · 平等         ║
    ║                                               ║
    ╚═══════════════════════════════════════════════╝
${RESET}${DIM}    v${CATFISH_VERSION}${RESET}

EOF
}

# ---------- 子命令 ----------

cmd_version() {
    echo "catfish v${CATFISH_VERSION}"
    if command -v "$HERMES_BIN" >/dev/null 2>&1; then
        echo "underlying: $($HERMES_BIN --version 2>/dev/null | head -1 || echo "$HERMES_BIN unknown version")"
    fi
}

cmd_status() {
    echo "${BOLD}=== 鲶鱼平台状态 ===${RESET}"
    echo

    # 1. Gateway
    local gw_endpoint="${CATFISH_GATEWAY_HOST}:${CATFISH_GATEWAY_PORT}"
    echo "${BOLD}[Gateway]${RESET}"
    if curl -sSf -m 2 "http://${gw_endpoint}/health" >/dev/null 2>&1; then
        echo "    ${GREEN}OK${RESET} catfish-gateway 跑着 (${gw_endpoint})"
    else
        echo "    ${YELLOW}OFF${RESET} gateway 没起。启动：cd central/llm-gateway && python -m catfish_gateway.app"
    fi
    echo

    # 2. Catfish Chrome
    local chrome_endpoint="${CATFISH_CHROME_DEBUG_HOST}:${CATFISH_CHROME_DEBUG_PORT}"
    echo "${BOLD}[Catfish Chrome]${RESET}"
    if curl -sSf -m 2 "http://${chrome_endpoint}/json/version" >/dev/null 2>&1; then
        chrome_ver="$(curl -s "http://${chrome_endpoint}/json/version" | python3 -c "import sys,json;print(json.load(sys.stdin).get('Browser',''))" 2>/dev/null || echo unknown)"
        echo "    ${GREEN}OK${RESET} CDP ${CATFISH_CHROME_DEBUG_PORT} 通 ($chrome_ver)"
    else
        echo "    ${YELLOW}OFF${RESET} 没起。启动：bash edge/browser-agent/scripts/catfish-browser-attach.sh"
    fi
    echo

    # 3. 本地搜索
    echo "${BOLD}[Local Search]${RESET}"
    if command -v catfish-search >/dev/null 2>&1; then
        catfish-search status 2>&1 | sed 's/^/    /'
    else
        echo "    ${YELLOW}未装${RESET}  装：bash onboarding/install-catfish.sh"
    fi
    echo

    # 4. SOUL 是否接管
    echo "${BOLD}[Identity (SOUL.md)]${RESET}"
    if [ -L "$HOME/.hermes/SOUL.md" ]; then
        target="$(readlink "$HOME/.hermes/SOUL.md")"
        case "$target" in
            *catfish*identity*)
                echo "    ${GREEN}OK${RESET} catfish 已接管"
                ;;
            *)
                echo "    ${YELLOW}其他${RESET} 软链到 $target"
                ;;
        esac
    elif [ -f "$HOME/.hermes/SOUL.md" ]; then
        echo "    ${YELLOW}默认${RESET} 没装 catfish identity。装：bash edge/identity/install.sh"
    else
        echo "    ${YELLOW}缺${RESET} ~/.hermes/SOUL.md 不存在"
    fi
    echo

    # 5. Hermes 本体
    echo "${BOLD}[Hermes Runtime]${RESET}"
    if command -v "$HERMES_BIN" >/dev/null 2>&1; then
        echo "    ${GREEN}OK${RESET} $($HERMES_BIN --version 2>/dev/null | head -1 || echo "$HERMES_BIN")"
    else
        echo "    ${YELLOW}未装${RESET} 装 Hermes Agent"
    fi
}

cmd_doctor() {
    echo "${BOLD}=== 鲶鱼自检 ===${RESET}"
    cmd_status
    echo
    echo "${BOLD}[Python]${RESET}"
    if command -v python3 >/dev/null 2>&1; then
        echo "    ${GREEN}OK${RESET} $(python3 --version)"
    else
        echo "    ${YELLOW}缺${RESET} python3"
    fi
    echo
    echo "${BOLD}[路径检查]${RESET}"
    case ":$PATH:" in
        *":$HOME/.local/bin:"*)
            echo "    ${GREEN}OK${RESET} ~/.local/bin 在 PATH"
            ;;
        *)
            echo "    ${YELLOW}WARN${RESET} ~/.local/bin 不在 PATH（catfish-* 命令找不到）"
            ;;
    esac
}

# ---------- 主分发 ----------

main() {
    # 优先识别 catfish 自有的 meta 命令（不进 Hermes）
    case "${1:-}" in
        version|-v|--version)
            cmd_version
            exit 0
            ;;
        status)
            shift
            cmd_status "$@"
            exit 0
            ;;
        doctor|self-check|check)
            shift
            cmd_doctor "$@"
            exit 0
            ;;
        --raw)
            shift
            nuke_proxy_for_hermes
            exec "$HERMES_BIN" "$@"
            ;;
        --no-banner)
            shift
            nuke_proxy_for_hermes
            exec "$HERMES_BIN" "$@"
            ;;
        -h|--help)
            cat <<EOF
${BOLD}catfish${RESET} - 鲶鱼平台员工入口

用法：
    catfish                    交互式启动（带鲶鱼 banner）
    catfish --no-banner        不打 banner 直接进 hermes
    catfish --raw              透传给底层 hermes，不加任何包装
    catfish status             看平台整体状态（gateway / Chrome / 搜索 / SOUL / Hermes）
    catfish doctor             深度自检
    catfish version            看版本
    catfish <hermes 子命令>    透传给 hermes（chat / model / mcp / sessions ...）

环境变量:
    CATFISH_KEEP_PROXY=1       不要 unset HTTPS_PROXY/HTTP_PROXY (默认 unset 防代理劫持 localhost)
    CATFISH_GATEWAY_HOST        默认 127.0.0.1
    CATFISH_GATEWAY_PORT        默认 8999
    CATFISH_CHROME_DEBUG_PORT   默认 9222

一切问题先跑 catfish doctor 看哪条红 / 黄。
EOF
            exit 0
            ;;
    esac

    # 默认：打 banner，净化代理 env，进入 hermes
    banner
    nuke_proxy_for_hermes
    exec "$HERMES_BIN" "$@"
}

main "$@"
