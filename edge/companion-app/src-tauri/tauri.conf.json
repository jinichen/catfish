{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catfish Companion",
  "version": "1.0.0",
  "identifier": "com.catfish.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "鲶鱼 Companion",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "minimizable": true,
        "maximizable": true,
        "closable": true,
        "dragDropEnabled": false
      },
      {
        "label": "pet",
        "title": "鲶鱼桌宠",
        "url": "/pet.html",
        "width": 200,
        "height": 200,
        "x": 1200,
        "y": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "closable": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "connect-src": "'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* tauri: ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: asset: http://asset.localhost https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "media-src": "'self' asset: http://asset.localhost blob: data:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/catfish-tts-*.wav",
          "$TEMP/catfish-tts-*-*.wav",
          "/tmp/catfish-tts-*.wav",
          "/tmp/catfish-tts-*-*.wav",
          "/private/tmp/catfish-tts-*.wav",
          "/private/tmp/catfish-tts-*-*.wav"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "swift/catfish-calendar": "./",
      "resources/windows/install.ps1": "./resources/windows/install.ps1",
      "resources/windows/uv.exe": "./resources/windows/uv.exe",
      "resources/windows/cpython-3.11.15-embed.zip": "./resources/windows/cpython-3.11.15-embed.zip",
      "resources/windows/hermes-agent-bundle.tar.gz": "./resources/windows/hermes-agent-bundle.tar.gz",
      "resources/windows/chromium-embed.tar.gz": "./resources/windows/chromium-embed.tar.gz",
      "resources/windows/catfish-email-dist.tar.gz": "./resources/windows/catfish-email-dist.tar.gz",
      "resources/windows/hermes-deps-dist.tar.gz": "./resources/windows/hermes-deps-dist.tar.gz",
      "resources/windows/catfish-wechat-reader-dist.tar.gz": "./resources/windows/catfish-wechat-reader-dist.tar.gz",
      "resources/windows/install-wechat-reader.ps1": "./resources/windows/install-wechat-reader.ps1"
    },
    "macOS": {
      "bundleName": "鲶鱼",
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "zh-CN",
        "template": "wix/main.wxs",
        "fragmentPaths": ["wix/catfish-postinstall.wxs"],
        "featureRefs": ["CatfishPostInstallFeature"]
      }
    }
  }
}
