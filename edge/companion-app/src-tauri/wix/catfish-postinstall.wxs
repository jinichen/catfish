<?xml version="1.0" encoding="utf-8"?>
<!--
  Catfish postinstall WiX fragment (W2 BL-CATFISH-WIN-MSI 7/11 → W2.5 refine 7/11).

  msi CustomAction: 装完 files 后自动跑 install.ps1 装 hermes 到
  %LOCALAPPDATA%\hermes\ (offline 模式, 走 msi 内嵌 uv.exe + python zip +
  hermes-agent tarball, 全 sandboxed 无网).

  = W2.5 refactor (方案 C, 换掉方案 A 嵌套 quoting) =

  Week 2 原设计走 CustomActionData 单串 + PowerShell -Command "& { $d = '[CAD]'.Split('|'); ... }"
  嵌套 quoting. Audit 发现: 员工用户名含单引号 (真实案例 O'Brien) 会破坏
  PowerShell 单引号 literal, .Split('|') 返错. 员工路径含 `|` 字符 (Windows
  合法) 也会切碎.

  方案 C: 拆 4 个独立 property + 双引号 wrap. 参考 msi CustomAction 标准姿势
  (Microsoft docs, Tauri 上游 main.wxs:294 DownloadAndInvokeBootstrapper 同款).

  好处:
  - ExeCommand 从 3 层嵌套 quoting (WiX XML entity + msi Format + PowerShell)
    压成 2 层 (WiX XML + msi Format). 无 PowerShell 内嵌 quoting.
  - 4 property 各自双引号 wrap, msi Format 展开时空格路径自动 OK.
  - 无 .Split, 员工路径含 `'` / `|` 都 safe.
  - 唯一还剩坑: 路径含 `"` — 但 Windows 路径本身不允许 `"` 字符
    (https://learn.microsoft.com/en-us/windows/win32/fileio/naming-a-file),
    real 0 风险.

  = deferred CustomAction 拿不到 [INSTALLDIR] 的 4 步 pattern =

  Microsoft docs (https://learn.microsoft.com/en-us/windows/win32/msi/obtaining-context-information-for-deferred-execution-custom-actions):
      "the property of interest to a property having the same name as the
       deferred execution custom action"

  但方案 C 需要 4 个 property, 都要传到 deferred CA. Microsoft 官方 pattern
  是 1 个 property = deferred CA Id, 值可以是 `key=val;key=val` 或 `|` 分隔.
  但我们已 audit 出 `.Split` 有坑, 所以走**另一种官方 pattern**:

  用 4 个 Type 51 immediate CA 分别 set 4 个 property → deferred CA
  ExeCommand 里直接引用 4 个 property 的 [XXX] format 展开. **无需 CustomActionData**.

  为啥可以? 因为 msi Format 展开发生在**deferred CA script 执行之前**
  (Format 在 install script generation 阶段, 即 immediate phase). 4 个
  property 的值那时已 set, Format 展开成命令行字面串, 存进 script.
  Deferred CA runtime 拿到的是**已展开好**的命令行, 不再需要 property lookup.

  Ref: https://learn.microsoft.com/en-us/windows/win32/msi/formatted 的
  "Formatted string" 处理时机: 在 sequence table 处理时 (即 immediate phase),
  非 deferred runtime phase.

  = 4 property 命名 =

  - CatfishInstallPs1Path : [INSTALLDIR]resources\windows\install.ps1
  - CatfishHermesSourceDir: [INSTALLDIR]hermes\hermes-agent-src
  - CatfishUvExePath      : [INSTALLDIR]resources\windows\uv.exe
  - CatfishPythonZipPath  : [INSTALLDIR]resources\windows\cpython-3.11.15-embed.zip

  = Impersonate="yes" + Return="check" =

  跟 W2 原设计一致, 用户拍板未变:
  - Impersonate=yes: perUser MSI 必须 (Single Package Authoring)
  - Return=check: install.ps1 fail → msi rollback (员工看到明确失败)
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!--
      W2.16 (7/13 CI run #11 铁证): candle CNDL0037 挂 line 104 CatfishRunInstall
      缺 anchor attr. <CustomAction ExeCommand=...> 必须搭配 BinaryKey|Directory|
      FileKey|Property 之一让 msi 知道 CA type. 我们跑系统预装 powershell.exe
      (msi 未安装的外部 exe) → Type 50 (Property = exe 全路径).

      POWERSHELLEXE (UPPERCASE 因为公开 property, msi Format 展开 [SystemFolder]
      为 C:\Windows\System32 全路径). msi Type 50 语义: property 值 = 全 exe 路径,
      ExeCommand = 参数, msi 拼 `<Property值> <ExeCommand>` 起 process.
    -->
    <Property Id="POWERSHELLEXE" Value="powershell.exe"/>

    <!--
      Step 1: 5 个 Type 51 SetProperty immediate CA. 4 个 catfish 路径 + 1 个
      POWERSHELLEXE 全路径 (拼 [SystemFolder]). Type 51 doc:
      https://learn.microsoft.com/en-us/windows/win32/msi/custom-action-type-51
    -->
    <CustomAction Id="SetPowerShellExePath"
                  Property="POWERSHELLEXE"
                  Value="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe"
                  Execute="immediate"/>

    <CustomAction Id="SetCatfishInstallPs1Path"
                  Property="CatfishInstallPs1Path"
                  Value="[INSTALLDIR]resources\windows\install.ps1"
                  Execute="immediate"/>

    <CustomAction Id="SetCatfishHermesSourceDir"
                  Property="CatfishHermesSourceDir"
                  Value="[INSTALLDIR]hermes\hermes-agent-src"
                  Execute="immediate"/>

    <CustomAction Id="SetCatfishUvExePath"
                  Property="CatfishUvExePath"
                  Value="[INSTALLDIR]resources\windows\uv.exe"
                  Execute="immediate"/>

    <CustomAction Id="SetCatfishPythonZipPath"
                  Property="CatfishPythonZipPath"
                  Value="[INSTALLDIR]resources\windows\cpython-3.11.15-embed.zip"
                  Execute="immediate"/>

    <!--
      Step 2: deferred CA. 引用 4 个 property 的 [XXX] format 展开.
      每个 property 值双引号 wrap 处理空格路径.

      展开后 (假设 INSTALLDIR = C:\Users\O'Brien\AppData\Local\Catfish Companion\):
        powershell.exe -NoProfile -ExecutionPolicy Bypass
          -File "C:\Users\O'Brien\AppData\Local\Catfish Companion\resources\windows\install.ps1"
          -NonInteractive
          -OfflineSourceDir "C:\Users\O'Brien\AppData\Local\Catfish Companion\hermes\hermes-agent-src"
          -OfflineUvExe     "C:\Users\O'Brien\AppData\Local\Catfish Companion\resources\windows\uv.exe"
          -OfflinePythonZip "C:\Users\O'Brien\AppData\Local\Catfish Companion\resources\windows\cpython-3.11.15-embed.zip"

      注意: 路径里 `'` (O'Brien 用户名) 在双引号 wrap 下无害
      (PowerShell 双引号 literal 允许 `'`, 也不需要 Split).
    -->
    <!--
      W2.16 修 CNDL0037: 加 Property="POWERSHELLEXE" 让 candle 认成 Type 50.
      Type 50 语义: msi Format 展开时拼 `<POWERSHELLEXE值> <ExeCommand>` 起 process,
      所以 ExeCommand 去掉开头 powershell.exe (会由 Property 值 prepend).
    -->
    <CustomAction Id="CatfishRunInstall"
                  Property="POWERSHELLEXE"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check"
                  ExeCommand='-NoProfile -ExecutionPolicy Bypass -File "[CatfishInstallPs1Path]" -NonInteractive -OfflineSourceDir "[CatfishHermesSourceDir]" -OfflineUvExe "[CatfishUvExePath]" -OfflinePythonZip "[CatfishPythonZipPath]"'/>

    <!--
      Step 3: sequence. 4 SetProperty CA 排 After=CostFinalize
      (此时 [INSTALLDIR] 已 resolve), deferred CA 排 After=InstallFiles
      (此时 resources/ 已到 disk).

      SetProperty 4 个 CA 无相对顺序要求 (都是 immediate, 都读 INSTALLDIR),
      按 wxs 顺序即可. NOT REMOVE 条件 = 只在装 / 升级跑, 不在卸载跑.
    -->
    <InstallExecuteSequence>
      <Custom Action="SetPowerShellExePath"       After="CostFinalize">NOT REMOVE</Custom>
      <Custom Action="SetCatfishInstallPs1Path"   After="SetPowerShellExePath">NOT REMOVE</Custom>
      <Custom Action="SetCatfishHermesSourceDir"  After="SetCatfishInstallPs1Path">NOT REMOVE</Custom>
      <Custom Action="SetCatfishUvExePath"        After="SetCatfishHermesSourceDir">NOT REMOVE</Custom>
      <Custom Action="SetCatfishPythonZipPath"    After="SetCatfishUvExePath">NOT REMOVE</Custom>
      <Custom Action="CatfishRunInstall"          After="InstallFiles">NOT REMOVE</Custom>
    </InstallExecuteSequence>

    <!--
      Feature envelope. Tauri wix.featureRefs 必须引用一个 Feature Id 才会把
      fragment 里定义的东西 include 进 msi. CustomAction 不需要 ComponentRef,
      Feature 空 (只做载体).
    -->
    <Feature Id="CatfishPostInstallFeature"
             Title="Catfish post-install (hermes 装机)"
             Level="1"
             Absent="disallow"
             AllowAdvertise="no"
             Display="hidden">
      <!-- No ComponentRef. CustomAction 通过 InstallExecuteSequence 自动 scheduling. -->
    </Feature>
  </Fragment>
</Wix>
