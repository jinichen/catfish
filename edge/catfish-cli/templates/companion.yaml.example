# ~/.catfish/companion.yaml — Companion 桌面 app 配置
#
# 装法:
#   1. cp ~/person_task/catfish/edge/catfish-cli/templates/companion.yaml.example \
#         ~/.catfish/companion.yaml
#   2. 改你需要的字段
#   3. 重启 Companion 生效 (yaml 进程内只读一次, 不 hot-reload)
#
# 优先级: env > yaml > default. 这文件管 yaml; env 看 catfish doctor / endpoints.rs 注释.

endpoints:
  # 网关地址 — 默认 127.0.0.1:8999 (本机 hermes-gateway).
  # 内网中央部署改成 e.g. http://10.10.40.50:8999, 客户端不用打包 gateway.
  # env override: CATFISH_GATEWAY_URL (完整 URL) / CATFISH_GATEWAY_HOST + CATFISH_GATEWAY_PORT
  gateway_url: http://127.0.0.1:8999

  # Chrome remote debug (Claude in Chrome plugin 用). 一般本机, 不用动.
  # env override: CATFISH_CHROME_DEBUG_HOST + CATFISH_CHROME_DEBUG_PORT
  chrome_debug_url: http://127.0.0.1:9222

  # catfish-web 中央门户 (Dashboard "去 web 看 →" 锚点). dev 默认 vite 5173,
  # 生产建议 nginx 同域 (跟 gateway 同 origin) 或独立 web 服务.
  # 留空 → 推导 (本机→localhost:5173, 远程→gateway 同 host).
  web_url: ""
