<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  BL-CATFISH-ENV-PERSISTENT (6/4 鸿波拍) — catfish 真**`持久 launchctl env`**.

  背景: BL-CATFISH-WIKI-MODE P1.1 真**`CATFISH_WIKI_ENABLE` env 真**控**真 wiki two-step
  ingest 开关 (默认 off 省 LLM 成本). 之前真**`launchctl setenv CATFISH_WIKI_ENABLE 1`**
  真**`session-scoped`**, macOS 重启就 unset → hermes-gateway launchd 启动时**继承空 env**
  → wiki distill 不跑.

  这 plist 真**boot 时跑一次** `launchctl setenv`, 真**`set global env`** 真**`hermes-gateway`** 真
  `launchd fork`真**`继承`**真.

  装法:
    cp ~/person_task/catfish/edge/catfish-cli/launchd/com.catfish.env.plist \
       ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.catfish.env.plist
    launchctl kickstart gui/$(id -u)/com.catfish.env   # 立刻跑一次 set env
    launchctl getenv CATFISH_WIKI_ENABLE   # 验, 期望 1

  卸法:
    launchctl bootout gui/$(id -u)/com.catfish.env
    launchctl unsetenv CATFISH_WIKI_ENABLE
    rm ~/Library/LaunchAgents/com.catfish.env.plist

  改 env 值 (e.g. 临时禁 wiki):
    launchctl setenv CATFISH_WIKI_ENABLE 0   # 临时 (重启 unset)
    # 或改 plist 真 ProgramArguments 真**`set 1` → `set 0`** + 真重 bootstrap

  跟 catfish doctor 配合: catfish doctor 真**`[Wiki Mode]`** 真**`check`** 真
  `launchctl getenv CATFISH_WIKI_ENABLE`. 这 plist 装好 → doctor 显 green.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.catfish.env</string>

    <!-- launchctl setenv 真 set global env. Daemon 起不来 (执行完 setenv 退出), 不 KeepAlive. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <!-- 一行 sh 真**真**`set CATFISH_WIKI_ENABLE=1`**.
             真**`未来 加更多 env`** 真**`真**`/bin/sh -c "launchctl setenv A 1; launchctl setenv B 2"`** -->
        <string>/bin/launchctl setenv CATFISH_WIKI_ENABLE 1</string>
    </array>

    <!-- 系统启动时跑一次 (login 真**或** boot). 真**`set 完 sh exit`**. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 真**`一次性 task`** — 不 KeepAlive (不长跑) -->
    <key>KeepAlive</key>
    <false/>

    <!-- log (调试用) -->
    <key>StandardOutPath</key>
    <string>/tmp/catfish-env.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/catfish-env.log</string>

    <!-- 只在用户 GUI 登录时跑 -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
