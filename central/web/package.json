{
  "name": "catfish-web",
  "version": "0.1.0",
  "description": "Catfish 中央门户 web app — Skills Hub / MCP 市场 / Manager / Admin (BL-ARCH1, 5/10 起做)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 5173",
    "build": "npm run check && tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "lint": "npm run check && tsc --noEmit",
    "check": "npm run check:routes && npm run check:css && npm run check:audit-limits",
    "check:routes": "node scripts/check-admin-routes.mjs",
    "check:css": "node scripts/check-css-vars.mjs",
    "check:audit-limits": "node scripts/check-audit-limits.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "oidc-client-ts": "^3.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
