# 鲶鱼中央服务生产环境配置 — docker-compose 用 (五一 sprint 5/2 收尾 BL-F7).
#
# 用法:
#   1. cp .env.production.example .env
#   2. 改下面的密码 / domain / API key
#   3. docker compose up -d
#
# 安全:
#   .env 进 .gitignore (含密码), .example 进 git 作模板.

# ── 主密钥 (8/1) ────────────────────────────────────────────────────
#
# 供应商 API key 加密存库用。生成 (服务器上跑一次):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠⚠ 生成后**立刻存进公司密码管理器**。
#    丢了的话所有存库的 API key 都解不开 —— 只能逐个重新申请再重填。
#    代码兜不住这件事。
#
# 一次配好不再动。配了之后, 加供应商 / 换 API key 全在界面上做:
#   · 不用改这个文件
#   · 不用改 docker-compose.yml
#   · 不用重建容器, 也不用重启网关 (配置 3 秒内热加载)
#
# 没配也能跑 —— 那就退回老办法: key 写在下面的 *_API_KEY 里, 加供应商要
# 改两个文件 + 重建容器。见 docs/DESIGN-PROVIDER-SPLIT-20260730.md §2。
# 🔑 原样留着 —— deploy.sh 会自动生成并写回这里。
#    生成后**立刻存进公司密码管理器**: 丢了的话所有存库的 API key 都解不开。
#    重跑 deploy.sh 不会覆盖已有的值。
CATFISH_SECRET_KEY=CHANGE_ME_RUN_THE_COMMAND_ABOVE

# ── PostgreSQL ──
PG_USER=catfish
# 🔑 原样留着 —— deploy.sh **首次部署时**自动生成。
#    ⚠ postgres 的密码是 volume 初始化那一刻定下的, 之后改这里不会改库里的,
#    只会连不上。所以 volume 已存在时脚本会拒绝生成, 让人工处理。
PG_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
PG_DB=catfish

# ── uvicorn worker 数 (6/9 BL-F10 实测调优) ──
# 默认 gateway 4 / identity 2, 基于客户 4 vCPU 机房假设.
# BL-F10 1000 user 实测: 单 worker P99=34s / 4 worker P99=15s (2.2× 吞吐, 56% 降).
# 部署机更大改这: 8 vCPU → GATEWAY_WORKERS=8, IDENTITY_WORKERS=4
GATEWAY_WORKERS=4
IDENTITY_WORKERS=2

# ── 内网 LLM (私有 tier 模型必填, models.yaml 引用 ${INTERNAL_LLM_KEY}) ──
# 内网 LLM 平台申请的 API key. 不下发到员工, 只在 gateway server.
INTERNAL_LLM_KEY=CHANGE_ME

# ── 内网 LLM 端点 URL (必填, 7/16 BL-ENV-INTERNAL-BASE 补) ──
# 客户内网 qwen / embedding 平台, OpenAI-compatible /v1 endpoint.
# 3 URL 可指向同 base (若客户 qwen 平台同时提供 chat/vision/embedding),
# 或指向不同 base (分 3 后端).
#
# 示例 (达华内网, 换成实际 IP:port):
#   INTERNAL_LLM_BASE_QWEN_MAIN=http://10.0.5.20:9998/v1
#   INTERNAL_LLM_BASE_QWEN_VISION=http://10.0.5.20:9998/v1
#   INTERNAL_LLM_BASE_BGE_M3=http://10.0.5.20:9997/v1
#
# 不改 → docker-compose.yml default http://127.0.0.1:9998/v1 (dev 值),
# gateway 起来后所有内网请求 502 (127.0.0.1 里没 qwen).
INTERNAL_LLM_BASE_QWEN_MAIN=http://CHANGE_ME_INTERNAL_QWEN_HOST:9998/v1
INTERNAL_LLM_BASE_QWEN_VISION=http://CHANGE_ME_INTERNAL_QWEN_HOST:9998/v1
INTERNAL_LLM_BASE_BGE_M3=http://CHANGE_ME_INTERNAL_EMBEDDING_HOST:9998/v1

# ── OIDC (SSO) ──
# 客户用自己的 IdP (飞书 / 钉钉 / 企微 / Keycloak / 自建) 时改成他们的 issuer。
# 不改就走 stack 自带的 catfish-identity。
#
# ⚠ 8/1 修: 这里原来写的是 `https://catfish.yourcompany.com/sso` —— 那**正好是
#   deploy.sh 用来判断"还没填"的占位符**。于是照 SOP 走 (cp example → 只改
#   那 4 项) 必然在 .env 体检时被拒, 而 SOP 表格里又标着它可选, 客户会懵。
#   docker-compose 本来就给了默认值 (${CATFISH_OIDC_ISSUER:-http://host.docker.internal:8998}),
#   所以这里放一个能直接用的值, 而不是一个长得像真值的占位。
#
# Linux 生产: host.docker.internal 不一定通, 换成服务器 IP 或域名。
CATFISH_OIDC_ISSUER=http://host.docker.internal:8998
CATFISH_OIDC_AUDIENCE=catfish-gateway
# Gateway → Identity admin API. Bundled stack uses Docker DNS; external Identity may override.
CATFISH_IDENTITY_URL=http://identity:8998

# ── 公网 LLM API key (按需开, 7/16 达华: 同时支持本地+公网) ──
# 3 个 key 决定 catfish-public-* 模型能否用. 留空 = 该模型不出现在员工 catalog.
# 测试期建议至少填 1 个 (推荐 DASHSCOPE, 阿里 dashscope 免费 test tokens 好申请).
# 全填 = 内网挂了自动 fallback 3 层公网 (qwen-flash → deepseek → gemini).
# 全空 = 只走内网 (若内网挂 gateway 直接 502 给员工).
DASHSCOPE_API_KEY=          # 阿里 qwen-flash, 申请: https://dashscope.console.aliyun.com/
DEEPSEEK_API_KEY=           # Deepseek V4, 申请: https://platform.deepseek.com/api_keys
GEMINI_API_KEY=             # Google Gemini pro/flash, 申请: https://aistudio.google.com/app/apikey

# ── Skills Hub ──
# 共享 token, manager+ 用这个发布 skill (后续改真 OIDC).
# 至少 32 位随机, 内部分发给 manager.
# 🔑 原样留着 —— deploy.sh 会自动生成。
SKILLS_HUB_TOKEN=CHANGE_ME_RANDOM_32_CHARS

# P3.4.1-cleanup2 (7/14): 砍 CATFISH_SECRET_MASTER_KEY 定义.
# P3.4.1 (6/13 hb) 已砍 secret-broker 服务 (manifesto 数据本地化红线, 中央
# 存员工 OAuth token 政企不合规). OAuth token 改 Companion 本机存, 不再需要
# 中央 AES 主密钥.

# ── 域名 (nginx 反代用) ──
# 改 nginx.conf 里的 server_name + Let's Encrypt cert 路径
# 默认 catfish.example.com, 你的域名改成 catfish.yourcompany.com
DOMAIN=catfish.example.com
