# ============================================================
# Catfish MCP Registry · 环境变量
# 复制为 .env (.gitignore 已 cover *.env, 不进 git).
# ============================================================

# 中央 PG (BL-D3 Phase 2 5/9): 跨 service 共享, 跟 gateway / identity / skills-hub
# 同一个 catfish 实例. 表前缀 mcp_ 防冲突.
# 留空 → db.py 走 sqlite fallback (~/.catfish/mcp_registry.db, dev/单测兼容).
# 密码含 ! 等保留字符必须 percent-encode (! → %21, @ → %40 etc.).
CATFISH_DB_URL=postgresql://catfish:replace-with-strong-password@localhost:5432/catfish

# 启动监听 (默认 127.0.0.1:8996, 跟 skills-hub 8997 / gateway 8999 错开).
HOST=127.0.0.1
PORT=8996

# Secret Broker 地址 (OAuth token 走它加密 keyring 存储)
CATFISH_SECRET_BROKER_URL=http://127.0.0.1:8995

# OAuth 模式: mock (demo 直发 mock_token) / real (调真上游 token_url 换 token)
CATFISH_MCP_OAUTH_MODE=mock

# 真 OAuth (mode=real 时用, 跟客户 IT 拿)
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

LOG_LEVEL=INFO
