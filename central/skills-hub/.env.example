# ============================================================
# Catfish Skills Hub · 环境变量
# 复制为 .env 后填入真实值. .gitignore 已 cover *.env.
# ============================================================

# 中央 PG (BL-D2 Phase 2 5/10): 跨 service 共享, 跟 gateway / mcp-registry / identity
# 同一个 catfish 实例. 表前缀 skills_ 防冲突.
# 留空 → storage.py 走 FS only (dev / 单测兼容), 生产不推荐.
# 密码含 ! 等 RFC 3986 保留字符必须 percent-encode (! → %21, @ → %40 etc.).
CATFISH_DB_URL=postgresql://catfish:replace-with-strong-password@localhost:5432/catfish

# 启动监听 (默认 127.0.0.1:8997 只本机, 生产部署 hub 服务器才设 HOST=0.0.0.0).
HOST=127.0.0.1
PORT=8997

# 日志
LOG_LEVEL=INFO

# 内容文件根目录. 默认 ~/.catfish-hub/. 生产建议挂独立 volume.
# CATFISH_HUB_ROOT=/var/lib/catfish-hub

# 老 dev_token 鉴权兜底 (curl 测试用, 生产留空 → 强制 gateway X-Catfish-User-Sub).
# CATFISH_HUB_DEV_TOKEN=

# 老 admin token (delete / audit 端点 admin only). BL-D2 改 OIDC role=admin 后已无用,
# 留位仅 dev. 生产留空.
# CATFISH_HUB_ADMIN_TOKEN=
