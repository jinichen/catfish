# ============================================================
# Catfish Identity Server · 环境变量
# 复制为 .env (.gitignore 已 cover *.env, 不进 git)
# ============================================================

# 中央 PG (跨 service 共享, 跟 gateway / mcp-registry / skills-hub 同库)
# 留空 → 走 yaml-only 模式 (dev 兼容). 生产必配.
# 密码含 ! 等保留字符必须 percent-encode (! → %21)
CATFISH_DB_URL=postgresql://catfish:replace-with-strong-password@localhost:5432/catfish

# 启动监听 (默认 127.0.0.1:8998, 跟其他 service 端口错开)
CATFISH_IDENTITY_HOST=127.0.0.1
CATFISH_IDENTITY_PORT=8998

# OIDC issuer URL (跟 gateway / Companion / catfish-web 一致)
# dev: http://127.0.0.1:8998
# prod: https://sso.client.com (客户自建)
CATFISH_IDENTITY_ISSUER=http://127.0.0.1:8998

# users.yaml 路径 override (默认 config/users.yaml)
# CATFISH_IDENTITY_USERS_PATH=/etc/catfish/users.yaml

# CORS allow origins (BL-D6 fix1, 5/10): catfish-web 浏览器 PKCE flow 调
# /.well-known/openid-configuration / /jwks 用. dev 默认 localhost:5173 + 任意 localhost.
# 生产配具体 origin (catfish.client.com).
# CATFISH_IDENTITY_CORS_ORIGINS=https://catfish.client.com

LOG_LEVEL=INFO
