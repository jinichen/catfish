# Mock upstream image — 极小, 只 fastapi + uvicorn.
# DOCKER_REGISTRY build-arg 支持国内镜像 (默认空 = docker.io).
ARG DOCKER_REGISTRY=
FROM ${DOCKER_REGISTRY}python:3.12-slim

WORKDIR /app

# pip 走清华 mirror (BL-F10 鸿波 6/8: 国内 pypi.org 也走 Clash 撞拦, 直接用清华)
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --no-cache-dir 'fastapi>=0.115' 'uvicorn[standard]>=0.32'

COPY bench/mock_upstream.py /app/mock_upstream.py

EXPOSE 9999

# 4 worker — 别让 mock 自己成为瓶颈 (bench 是测 gateway, 不是测 mock)
CMD ["uvicorn", "mock_upstream:app", "--host", "0.0.0.0", "--port", "9999", "--workers", "4"]
