# ============================================================
# llm-gateway 配额基线 (通用, 随镜像发给每一家客户)
# ============================================================
#
# 镜像首次启动时拷进持久卷 ($CATFISH_QUOTAS_PATH, 见 Dockerfile CMD), 之后管理员
# 在门户「配额」页改的是卷里那份, 重建 / 升级镜像不覆盖。
#
# 10/31: 原来镜像拷的是 config/quotas.yaml —— 那份 git 不跟踪, 是打包机上的开发配置
# (写着某两位员工的单独额度), 跟着镜像发到了客户那里。现在基线只认这份跟踪的文件,
# 本机 config/quotas.yaml / dev_users.yaml / *.bak 由 .dockerignore 挡在镜像外。
#
# 不写任何具体员工 / 部门 / 模型: 那是每家客户自己的事, 在门户里配, 或写进
# delivery/catfish-poc/llm-gateway/config-overlay/quotas.yaml。
#
# 额度取值跟此前实际发出去的一致 (每人每分钟 300 万 / 每天 3 亿 token, 基本不卡),
# 不借这次改动顺手收紧 —— 收紧额度是客户的决定。后台任务 (记忆整理、邮件分诊等,
# 带 X-Catfish-Internal) 不计入员工额度。
defaults:
  per_user:
    tokens_per_minute: 3000000
    tokens_per_day: 300000000
  per_model: {}
  per_department: {}
overrides:
  users: {}
  departments: {}
