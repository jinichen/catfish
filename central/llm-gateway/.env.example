# ============================================================
# 鲶鱼网关 · 环境变量
# 复制为 .env 后填入真实值
# ============================================================

# 上游私有 LLM 的 API Key（从公司 LLM 平台申请）
# ⚠️ 只在网关服务器上，不要下发给员工
INTERNAL_LLM_KEY=replace-me

# ====== 内网 LLM 接入点（私有 tier 模型必填）======
# 这些值会被 config/models.yaml 里的 ${INTERNAL_LLM_BASE_*} 占位符引用。
# 不配的话 gateway 启动会立刻报"env variable XXX is referenced ... but not set"。
#
# 格式: 完整 URL 含 scheme + host + port + path, 不带尾部斜杠 (LiteLLM 自己会拼)
# 例:  http://10.10.40.102:32730/openapi/<uuid>/v1
INTERNAL_LLM_BASE_QWEN_MAIN=http://your-llm-host:port/openapi/your-uuid/v1
INTERNAL_LLM_BASE_QWEN_VISION=http://your-llm-host:port/openapi/your-uuid/v1
INTERNAL_LLM_BASE_BGE_M3=http://your-llm-host:port/openapi/your-uuid/v1

# ====== 公共模型（可选，不配置则对应模型自动从 catalog 隐藏）======

# Gemini (Google AI Studio)
# 在 https://aistudio.google.com/apikey 申请
# 留空 → Gemini 模型不会出现在员工 catalog 里，也无法调用
GEMINI_API_KEY=

# 阿里云百炼 (DashScope) — Qwen 公共云
# 在 https://bailian.console.aliyun.com/?tab=model#/api-key 申请
# 留空 → catfish-public-qwen-* 模型不出现在 catalog
# 用途: 内网 Qwen 不可达时的公共备份, 或 Gemini 配额耗尽时的 fallback
DASHSCOPE_API_KEY=

# NVIDIA NIM (build.nvidia.com) — Llama 3.3 / DeepSeek-R1 / Nemotron 等开源模型
# 在 https://build.nvidia.com 注册账号, 右上"Get API Key" 申请
# 留空 → catfish-public-nvidia-* 模型不出现在 catalog
# 用途:
#   - 内网 Qwen 不可达 + DashScope 配额耗尽 + DeepSeek 抽风时的第 3 兜底
#   - Llama 3.3 70B instruction-following 比 qwen3.6-flash 稳一档
#   - Nemotron Super 49B reasoning 能力跟 DeepSeek-R1 同级
# 免费额度: 注册后 1000 calls/月 (NVIDIA Developer Program), 比 DashScope free tier 大
NVIDIA_API_KEY=

# Groq (api.groq.com) — OpenAI gpt-oss 开源权重 + Llama / Mixtral / DeepSeek-R1 等
# 在 https://console.groq.com/keys 申请 (登录后右上 "Create API Key")
# 留空 → catfish-public-groq-* 模型不出现在 catalog
# 用途:
#   - 客户基建调研路径: Groq LPU 推理快 (TTFT 常 <500ms), 配 gpt-oss-120b 等开源权重
#   - 推理 / 复合任务备用模型, 主手选, 不入自动 fallback 链 (跟 NVIDIA NIM 同策略)
# 免费额度: 注册后有日 free quota, 重度使用要 paid plan
GROQ_API_KEY=

# 未来可以按需加：
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY_EXTERNAL=
# AZURE_OPENAI_API_KEY=

# Dev 模式的静态 Token (P0 阶段用, P1 切换为 SSO)
# BL-FIX29 (5/10): 默认注释, 强制走 OIDC. 老 'dev-token-local' 会被 gateway
# 拒 (config/dev_users.yaml 也要清空 users[]). 客户 IT 配 SSO 阶段才临时启用
# 救急 — 配好后立刻删. 生成建议: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CATFISH_DEV_TOKEN=replace-with-strong-random

# 部署环境：dev | prod
CATFISH_ENV=prod

# 模型配置文件路径
CATFISH_CONFIG=config/models.yaml

# ====== 文案降级兜底 (P3.5.139 6/29 鸿波"都要去除硬编码") ======
# quota 超额错误消息会建议员工"换 X 模型试试", 其中 X 是 roles.yaml 里
# `chat_default` / `public_flash` 这两个 role 对应的 model name.
#
# 正常情况 gateway startup load roles.yaml 成功, 这两个 env 不生效.
# roles.yaml load 失败 (yaml 语法错 / 文件不在), 文案兜底走这里.
#
# 这是文案降级 (给员工看的提示), 不影响路由. 路由 chain (picker > role > yaml)
# 在 Companion 端, gateway 自己只有 roles.yaml 一个 truth source.
#
# 留空 → 文案渲染成 "换 (内网不限)" 略丑, dev 启动 gateway 没 .env 时可见.
# 不应该出现在正常 production — 配上对应客户主力 model 名.
#
# 命名 convention: CATFISH_FALLBACK_{ROLE_NAME.upper()}, 任何新 role 自动有
# 对应 env var, 不需要改代码.
CATFISH_FALLBACK_CHAT_DEFAULT=
CATFISH_FALLBACK_PUBLIC_FLASH=

# 日志
LOG_LEVEL=INFO

# 绑定 - gateway 自己监听
HOST=0.0.0.0
PORT=8999

# ====== 全栈共享 (Companion / feishu-monitor / catfish CLI 都读这些) ======
# 客户端拼 gateway URL 用; 跟上面 PORT 保持一致
CATFISH_GATEWAY_HOST=127.0.0.1
CATFISH_GATEWAY_PORT=8999
# 也可整条 URL 直接覆写 (留空则由 host+port 拼)
# CATFISH_GATEWAY_URL=

# Catfish Chrome 调试端口 (browser-agent / Companion / feishu-monitor 共享)
CATFISH_CHROME_DEBUG_HOST=127.0.0.1
CATFISH_CHROME_DEBUG_PORT=9222

# ====== OIDC / SSO (BL-FIX33 5/10) ======
# OIDC issuer URL — catfish-identity (或客户真实 SSO 提供方)
# 生产: 客户 IdP discovery URL (例 'https://sso.client.com')
# dev: catfish-identity 起在 127.0.0.1:8998
CATFISH_OIDC_ISSUER=http://127.0.0.1:8998
# OIDC audience claim — 必须跟 IdP 颁发 id_token 的 aud 字段对齐
# Companion authorize 请求 client_id=catfish-companion → IdP 颁 aud=catfish-companion
# **不是** 'test' (老默认坑过, BL-FIX33). 改 IdP 配置就连带改这里.
CATFISH_OIDC_AUDIENCE=catfish-companion

# ====== 中央 PG (BL-FIX27 5/10) ======
# 跨 service 共享 (catfish-identity / catfish-gateway / catfish-mcp-registry 一处配)
# 表前缀防冲突: users / quota_events / gateway_audit / mcp_subscriptions / mcp_audit
# 密码含特殊字符 (例 '!') 必须 percent-encode (RFC 3986): ! → %21, @ → %40 etc.
# 留空 → gateway / mcp-registry 走 sqlite fallback (dev / 单测兼容, 生产不推荐)
CATFISH_DB_URL=postgresql://catfish:replace-with-strong-password@localhost:5432/catfish
