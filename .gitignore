# Catfish 根级 .gitignore —— 各子项目自带的 .gitignore 也保留作为补充
#
# 三大重灾区（绝对不能 commit）:
#   - venv/             Python 虚拟环境，569MB+
#   - node_modules/     Node 依赖，86MB+
#   - target/           Rust 编译产物，3.6GB
#   - .companion-state/ Companion 运行时状态（PID / log / Chrome profile）

# ============================================================
# Companion 运行时状态 —— 全员工本机数据，绝不 commit
# ============================================================
.companion-state/
.catfish/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境（多个子项目都有）
venv/
.venv/
env/
.env/
ENV/

# 包构建产物
build/
dist/
*.egg-info/
*.egg
wheels/
.eggs/

# 测试 / lint 缓存
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
.mypy_cache/
.tox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Jupyter
.ipynb_checkpoints/

# ============================================================
# Node / TypeScript / Vite
# ============================================================
node_modules/
.pnpm-store/
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# nohup runtime log (skills-hub / mcp-registry / 各 service 启动脚本会用)
nohup.out

# 包管理器锁文件保留（lock 应该 commit）—— 不忽略 package-lock.json / pnpm-lock.yaml

# ============================================================
# Rust / Tauri
# ============================================================
# Cargo build target，每个子项目可能都有
target/
**/target/
Cargo.lock                       # 库项目忽略，二进制项目应保留
!edge/companion-app/src-tauri/Cargo.lock  # 这是二进制项目，保留 lock

# ============================================================
# 敏感配置（含 API key / token / 密码）
# ============================================================
.env
.env.local
.env.*.local
*.env.local
auth.json
*.pem
*.key
*.pfx
*.p12

# 但 .env.example 是模板，要 commit
!.env.example

# ============================================================
# OS / 编辑器
# ============================================================
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ============================================================
# 日志 / 临时文件
# ============================================================
*.log
*.pid
*.seed
*.pid.lock
logs/
tmp/
.tmp/

# ============================================================
# 数据库 / 索引
# ============================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 但 schema/migration 文件保留
!**/migrations/*.sql
!**/schema.sql

# ============================================================
# 临时草稿
# ============================================================
COMMITS_*.md                       # commit 草稿，commit 后即删
*.draft

# 部署相关配置, 每个环境不同, 不进 git
# 客户 / 个人本机改 timeout / 模型名 / fallback 等, 不互相覆盖
central/llm-gateway/config/models.yaml

# 数据库连接 (含密码), 五一 sprint 5/4 加. .example 进 git, 真实 yaml 不进
central/identity-server/config/database.yaml
central/llm-gateway/config/database.yaml

# Quota 限额, 每客户不同 (CEO 邮箱 / 部门名 / 公网 LLM 预算). .example 进 git.
central/llm-gateway/config/quotas.yaml

# Dev 多角色测试账号, 每开发机不同 (五一 sprint 5/2 RBAC). .example 进 git.
central/llm-gateway/config/dev_users.yaml

# 生产部署 (五一 sprint 5/2 BL-F7). .example 进 git, 真 .env / cert / nginx 配置不进.
central/.env
central/nginx.conf
central/certs/

# 防 backup 文件意外 commit (BL-MEMORY-COMMIT-FIX 5/16)
# 5/25 鸿波: 老 *.bak 只 match .bak 结尾, 不 match .bak.before-xxx.<timestamp>
# 这种带后缀 (5/22 撞过 .env.bak.before-legacy-summarize-off.2026-05-22T23-19-20
# 含 5 个真 API key 差点 commit). 改 *.bak* 一并覆盖.
*.bak
*.bak.*
*.bak2

# 一次性 commit 批处理脚本 — 跑完即丢, 不进 git 历史 (5/21 拆分日加)
.commit-*-*.sh
docs/CATFISH-INTRO-SPEAKER-SCRIPT.md
